+"""Exercise FS pipeline orchestration without Xcode or game data."""
+import ast
+from pathlib import Path
+import shutil
+import tempfile
+import unittest
+from unittest import mock
+
+SCRIPT = Path(__file__).resolve().parents[3] / 'scripts/build_ipa_from_nsp.py'
+
+
+class SharedRuntimePipelineTests(unittest.TestCase):
+    def setUp(self):
+        self.tmp = tempfile.TemporaryDirectory()
+        self.addCleanup(self.tmp.cleanup)
+        self.root = Path(self.tmp.name)
+        self.work = self.root / 'work'
+        self.output = self.work / 'shell-framework'
+        self.title = '0100123456789000'
+        self.names = ['DmGame' + self.title, 'DmSharedRuntime']
+        self.calls = []
+        self.missing = None
+        self.failed = False
+        def run(cmd, log, env, on_line):
+            self.calls.append((cmd, log, dict(env)))
+            if str(cmd[1]).endswith('build_shared_runtime.sh'):
+                if self.failed:
+                    raise RuntimeError('Xcode failed')
+                for name in self.names:
+                    product = self.work / 'shared-xcode/shared-build/Release-iphoneos' / (name + '.framework')
+                    product.mkdir(parents=True)
+                    (product / name).write_text('new')
+                    if name != self.missing:
+                        (product / ('shared-runtime.json' if name == 'DmSharedRuntime' else 'game.manifest.json')).write_text('{}')
+        tree = ast.parse(SCRIPT.read_text())
+        node = next(n for n in tree.body if isinstance(n, ast.FunctionDef) and n.name == 'build_shared_shell_framework')
+        ns = dict(Path=Path, shutil=shutil, tempfile=tempfile, run=run, BuildError=ValueError,
+                  rmtree=lambda p: shutil.rmtree(p) if p.exists() else None)
+        exec(compile(ast.Module(body=[node], type_ignores=[]), str(SCRIPT), 'exec'), ns)
+        self.build = ns[node.name]
+
+    def invoke(self):
+        self.build(self.root / 'engine', self.work, self.output, self.title,
+                   {'DM_FRAMEWORK_ONLY': str(self.output), 'KEEP': 'unchanged'}, self.work / 'logs', None)
+
+    def seed_legacy(self):
+        old = self.output / (self.names[0] + '.framework')
+        old.mkdir(parents=True)
+        (old / 'legacy-only').write_text('FH')
+        other = self.output / 'DmGameOTHER.framework'
+        other.mkdir()
+        (other / 'keep').write_text('FH')
+        return old, other
+
+    def test_reuses_existing_prepare_and_shared_builder_and_stages_both_products(self):
+        old, other = self.seed_legacy()
+        self.invoke()
+        self.assertEqual(len(self.calls), 2)
+        self.assertEqual(self.calls[0][0][-1], '--prepare-xcode')
+        self.assertTrue(str(self.calls[1][0][1]).endswith('/build_shared_runtime.sh'))
+        env = self.calls[0][2]
+        self.assertEqual(env['DM_FRAMEWORK_ONLY'], '')
+        self.assertEqual(env['DM_FRAMEWORK'], '1')
+        self.assertEqual(env['DM_FRAMEWORK_NAME'], self.names[0])
+        self.assertEqual(env['DM_COPY_ROMFS'], 'NO')
+        self.assertEqual(env['KEEP'], 'unchanged')
+        self.assertFalse((old / 'legacy-only').exists())
+        self.assertEqual((other / 'keep').read_text(), 'FH')
+        for name in self.names:
+            self.assertEqual((self.output / (name + '.framework') / name).read_text(), 'new')
+
+    def test_incomplete_product_does_not_replace_legacy_framework(self):
+        old, _ = self.seed_legacy()
+        self.missing = 'DmSharedRuntime'
+        with self.assertRaisesRegex(ValueError, 'incomplete'):
+            self.invoke()
+        self.assertEqual((old / 'legacy-only').read_text(), 'FH')
+
+    def test_build_failure_does_not_replace_legacy_framework(self):
+        old, _ = self.seed_legacy()
+        self.failed = True
+        with self.assertRaisesRegex(RuntimeError, 'Xcode failed'):
+            self.invoke()
+        self.assertEqual((old / 'legacy-only').read_text(), 'FH')
+
+    def test_replacement_failures_restore_the_previous_pair(self):
+        # Fail while backing up or publishing either product, not only while building.
+        for failed_move in range(1, 5):
+            with self.subTest(failed_move=failed_move):
+                self.setUp()
+                old, other = self.seed_legacy()
+                runtime = self.output / 'DmSharedRuntime.framework'
+                runtime.mkdir()
+                (runtime / 'previous').write_text('old runtime')
+                rename = Path.rename
+                calls = 0
+                def fail_once(source, target):
+                    nonlocal calls
+                    calls += 1
+                    if calls == failed_move:
+                        raise OSError('injected rename failure')
+                    return rename(source, target)
+                with mock.patch.object(Path, 'rename', fail_once):
+                    with self.assertRaisesRegex(OSError, 'injected rename failure'):
+                        self.invoke()
+                self.assertEqual((old / 'legacy-only').read_text(), 'FH')
+                self.assertEqual((runtime / 'previous').read_text(), 'old runtime')
+                self.assertEqual((other / 'keep').read_text(), 'FH')
+                self.assertFalse(list(self.output.glob('.shared-stage-*')))
+
+    def test_failed_first_install_removes_the_new_partial_pair(self):
+        rename = Path.rename
+        def fail_runtime(source, target):
+            if Path(target) == self.output / 'DmSharedRuntime.framework':
+                raise OSError('injected rename failure')
+            return rename(source, target)
+        with mock.patch.object(Path, 'rename', fail_runtime):
+            with self.assertRaisesRegex(OSError, 'injected rename failure'):
+                self.invoke()
+        self.assertEqual(list(self.output.iterdir()), [])
+
+    def test_cancellation_restores_legacy_game(self):
+        old, _ = self.seed_legacy()
+        rename = Path.rename
+        def cancel_runtime(source, target):
+            if Path(target) == self.output / 'DmSharedRuntime.framework':
+                raise KeyboardInterrupt()
+            return rename(source, target)
+        with mock.patch.object(Path, 'rename', cancel_runtime):
+            with self.assertRaises(KeyboardInterrupt):
+                self.invoke()
+        self.assertEqual((old / 'legacy-only').read_text(), 'FH')
+        self.assertFalse((self.output / 'DmSharedRuntime.framework').exists())
+        self.assertFalse(list(self.output.glob('.shared-stage-*')))
+
+    def test_failed_rollback_preserves_recovery_files(self):
+        old, _ = self.seed_legacy()
+        rename = Path.rename
+        def fail_publish_and_recovery(source, target):
+            if Path(target) in (old, self.output / 'DmSharedRuntime.framework'):
+                raise OSError('injected persistent rename failure')
+            return rename(source, target)
+        with mock.patch.object(Path, 'rename', fail_publish_and_recovery):
+            with self.assertRaisesRegex(ValueError, 'recovery files preserved at'):
+                self.invoke()
+        stages = list(self.output.glob('.shared-stage-*'))
+        self.assertEqual(len(stages), 1)
+        self.assertEqual((stages[0] / (old.name + '.previous') / 'legacy-only').read_text(), 'FH')
+
+    def test_new_shell_builds_use_shared_runtime_without_a_choice_or_fallback(self):
+        source = SCRIPT.read_text()
+        tree = ast.parse(source)
+        self.assertNotIn('--shared-runtime', source)
+        self.assertNotIn('args.shared_runtime', source)
+        guard = next(n for n in ast.walk(tree) if isinstance(n, ast.If)
+                     and ast.unparse(n.test) == 'shell_fw and programs')
+        check = compile(ast.Module(body=[guard], type_ignores=[]), str(SCRIPT), 'exec')
+        with self.assertRaisesRegex(ValueError, 'multi-program builds are not supported'):
+            exec(check, dict(shell_fw=Path('out'), programs={1: {}}, BuildError=ValueError))
+        exec(check, dict(shell_fw=Path('out'), programs=None, BuildError=ValueError))
+        exec(check, dict(shell_fw=None, programs={1: {}}, BuildError=ValueError))
+        shell_build = next(n for n in ast.walk(tree) if isinstance(n, ast.If)
+                           and isinstance(n.test, ast.Name) and n.test.id == 'shell_fw'
+                           and any(isinstance(child, ast.Call)
+                                   and isinstance(child.func, ast.Name)
+                                   and child.func.id == 'build_shared_shell_framework'
+                                   for child in ast.walk(n)))
+        calls = [n.func.id for n in ast.walk(shell_build) if isinstance(n, ast.Call)
+                 and isinstance(n.func, ast.Name)]
+        self.assertIn('build_shared_shell_framework', calls)
+        self.assertNotIn('run', calls)
+
+
+if __name__ == '__main__':
+    unittest.main()
