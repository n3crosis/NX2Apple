@@ -0,0 +1,213 @@
+#!/usr/bin/env python3
+"""Prepare shared-runtime targets from a DM_FRAMEWORK=1 --prepare-xcode workspace.
+
+Does not build, sign, install or modify the legacy project/manifest. Both targets
+are unsigned; shell integration must embed DmSharedRuntime.framework exactly once.
+"""
+from __future__ import annotations
+import argparse
+import hashlib
+import importlib.util
+import json
+from pathlib import Path
+import re
+import shlex
+import shutil
+
+ABI = PROFILE_ABI = 1
+SOURCE_SUFFIXES = {'.c', '.h', '.m', '.mm', '.inc', '.S', '.metal', '.swift', '.py', '.yml', '.sh'}
+
+
+def runtime_identity(dm: Path) -> str:
+    """Content identity excludes game profiles, generated data and absolute paths."""
+    digest = hashlib.sha256(b'NX2Apple shared runtime ABI 1 / profile ABI 1\0')
+    files = []
+    for name in ('host', 'gfx', 'audio', 'ios', 'third_party'):
+        root = dm / name
+        if not root.is_dir():
+            continue
+        for path in root.rglob('*'):
+            if not path.is_file() or path.is_symlink() or path.suffix not in SOURCE_SUFFIXES:
+                continue
+            rel = path.relative_to(dm)
+            if any(part in {'Gen', 'gen', 'build', 'tests', '__pycache__', '.git'} for part in rel.parts):
+                continue
+            files.append((rel.as_posix(), path))
+    if not any(name.startswith('host/') for name, _ in files):
+        raise ValueError('runtime host sources are missing')
+    for name, path in sorted(files):
+        digest.update(name.encode() + b'\0' + path.read_bytes() + b'\0')
+    return 'fs1-' + digest.hexdigest()
+
+
+def prepare(ios: Path, workspace: Path) -> dict:
+    ios, workspace = ios.resolve(), workspace.resolve()
+    gen = workspace / 'Gen'
+    for path in ('embed.S', 'dm.xcconfig', 'framework.xcconfig', 'src', 'main/main.c',
+                 'framework/game.manifest.json', 'framework/profile.tsv', 'framework/dm'):
+        if not (gen / path).exists():
+            raise ValueError(f'missing prepared input Gen/{path}; prepare with DM_FRAMEWORK=1 first')
+    if (gen / 'dm/programs.txt').exists():
+        raise ValueError('FS multi-program builds are not supported yet')
+    manifest = json.loads((gen / 'framework/game.manifest.json').read_text())
+    if manifest.get('loader') not in ('FR', 'FH'):
+        raise ValueError('expected a freshly prepared FR/FH source manifest')
+    chain_text = (ios.parent / 'gfx/nvn/dmsh_chain.h').read_text()
+    match = re.search(r'^#define DMSH_CHAIN "([0-9a-f]+)"', chain_text, re.M)
+    if not match:
+        raise ValueError('invalid shader chain header')
+    chain = 'b-' + match[1]
+    if manifest.get('chain') != chain:
+        raise ValueError('prepared game shader chain does not match the runtime')
+    title = manifest.get('title_id', '')
+    if not re.fullmatch('[0-9A-Fa-f]{16}', title):
+        raise ValueError('invalid manifest title_id')
+    executable = manifest.get('framework_executable', '')
+    if not re.fullmatch('[A-Za-z_][A-Za-z0-9_]*', executable):
+        raise ValueError('unsafe framework executable')
+    if manifest.get('framework') != executable + '.framework':
+        raise ValueError('framework folder and executable disagree')
+    if executable == 'DmGame':
+        executable += title.upper()
+        manifest['framework_executable'] = executable
+        manifest['framework'] = executable + '.framework'
+    profile_rows = {}
+    for line in (gen / 'framework/profile.tsv').read_text().splitlines():
+        if len(line.encode()) >= 4095:
+            raise ValueError('runtime profile row exceeds the host reader limit')
+        if line and not line.startswith('#'):
+            key, _, value = line.partition('\t')
+            profile_rows[key] = value
+    required = {'title_id', 'program_id', 'modules', 'mem_reserve', 'mem_stack',
+                'fps_max', 'ue_fps_cvar', 'launch_param', 'upscaler_keys', 'upscaler_n'}
+    if required - profile_rows.keys():
+        raise ValueError('runtime profile needs regeneration for FS: missing ' +
+                         ', '.join(sorted(required - profile_rows.keys())))
+    if profile_rows['title_id'].upper() != title.upper():
+        raise ValueError('runtime profile title does not match manifest')
+    keys = profile_rows['upscaler_keys']
+    if keys and not re.fullmatch('[0-9a-fA-F]{16}(,[0-9a-fA-F]{16})*', keys):
+        raise ValueError('invalid runtime upscaler shader keys')
+    if int(profile_rows['upscaler_n']) != (len(keys.split(',')) if keys else 0):
+        raise ValueError('runtime upscaler key count does not match')
+    descriptor = dict(abi=ABI, profile_abi=PROFILE_ABI, runtime_version=runtime_identity(ios.parent))
+    shared = gen / 'shared'
+    shared.mkdir(exist_ok=True)
+    if (shared / 'dm').exists():
+        shutil.rmtree(shared / 'dm')
+    shutil.copytree(gen / 'framework/dm', shared / 'dm')
+    launcher = gen / 'dm/launcher.json'
+    if not launcher.is_file():
+        launcher = gen / 'framework/dm/launcher.json'
+    if not launcher.is_file():
+        raise ValueError('missing prepared launcher settings')
+    shutil.copyfile(launcher, shared / 'dm/launcher.json')
+    receipt = dict(descriptor, chain=chain)
+    (shared / 'shared-runtime.json').write_text(json.dumps(receipt, indent=2) + '\n')
+    (shared / 'shared_runtime_version.h').write_text(
+        '#pragma once\n#define DM_SHARED_RUNTIME_VERSION ' + json.dumps(descriptor['runtime_version']) +
+        '\n#define DM_SHARED_SHADER_CHAIN ' + json.dumps(chain) + '\n')
+    manifest['loader'] = 'FS'
+    manifest['shared_runtime'] = descriptor
+    (shared / 'game.manifest.json').write_text(json.dumps(manifest, indent=2) + '\n')
+    # Host link configuration deliberately discards all embedded game segment flags.
+    config = (gen / 'dm.xcconfig').read_text().splitlines()
+    config = [line for line in config if not line.lstrip().startswith(('OTHER_LDFLAGS', 'CODE_SIGN_ENTITLEMENTS'))]
+    config = [line + ' "$(SRCROOT)/Gen/shared"' if line.startswith('HEADER_SEARCH_PATHS') else line for line in config]
+    config += ['OTHER_LDFLAGS = $(inherited) $(DM_FRAMEWORKS)']
+    (shared / 'runtime.xcconfig').write_text('\n'.join(config) + '\n')
+    (shared / 'game.xcconfig').write_text((gen / 'framework.xcconfig').read_text() +
+        '\nHEADER_SEARCH_PATHS = $(inherited) "$(SRCROOT)/Gen/shared"\n')
+    # Namespace every host Objective-C class; never borrow a per-game FH namespace.
+    spec = importlib.util.spec_from_file_location('shared_objc_namespace', ios / 'tools/gen_objc_namespace.py')
+    if spec is None or spec.loader is None:
+        raise ValueError('cannot load Objective-C namespace generator')
+    module = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(module)
+    classes = module.scan_objc_classes(module.default_source_roots(ios.parent))
+    if not classes:
+        raise ValueError('no runtime Objective-C classes found')
+    (shared / 'objc_namespace.h').write_text(module.render_namespace_header('SharedRuntime', classes))
+    exports = ['dm_glue_version', 'dm_glue_start_game', 'dm_glue_present_game', 'dm_glue_focus_event',
+               'dm_shared_runtime_descriptor']
+    (shared / 'runtime.exports').write_text(''.join('_' + s + '\n' for s in exports))
+    (shared / 'game.exports').write_text('_dmgame_image_marker\n_dm_shared_game_descriptor\n')
+    for name in ('Sources', 'framework'):
+        dest = workspace / name
+        if not dest.exists():
+            dest.symlink_to(ios / name, target_is_directory=True)
+    template = (ios / 'project-shared-runtime.yml').read_text()
+    values = {'__GAME_PRODUCT__': executable, '__TITLE_ID__': title.lower(),
+              '__RUNTIME_VERSION__': descriptor['runtime_version'], '__CHAIN__': chain}
+    for old, new in values.items():
+        template = template.replace(old, new)
+    (workspace / 'project-shared-runtime.yml').write_text(template)
+    return receipt
+
+
+def stage_products(workspace: Path) -> None:
+    """Stage game-owned resources, never ROMFS, into the unsigned FS product."""
+    gen = workspace / 'Gen'
+    manifest = json.loads((gen / 'shared/game.manifest.json').read_text())
+    executable = manifest['framework_executable']
+    if not re.fullmatch('[A-Za-z_][A-Za-z0-9_]*', executable):
+        raise ValueError('unsafe framework executable')
+    product = workspace / 'shared-build/Release-iphoneos' / (executable + '.framework')
+    if not (product / executable).is_file():
+        raise ValueError('FS game framework has not been built')
+    paths = {}
+    # Parse the generated assignments as data. Never source or eval an env file.
+    for line in (gen / 'resources.env').read_text().splitlines():
+        words = shlex.split(line, comments=True)
+        if not words:
+            continue
+        if len(words) != 1 or '=' not in words[0]:
+            raise ValueError('invalid prepared resource assignment')
+        key, value = words[0].split('=', 1)
+        paths[key] = value
+    if paths.get('DM_RESOURCE_PROGRAMS'):
+        raise ValueError('FS multi-program builds are not supported yet')
+    folder = paths.get('DM_RESOURCE_MSLDIR', '')
+    if folder not in (manifest['chain'], 'vk', 'gl'):
+        raise ValueError('shader resource folder does not match FS game')
+    shaders = Path(paths.get('DM_RESOURCE_SHADERS', ''))
+    if not shaders.exists() or not paths.get('DM_RESOURCE_SHADERS'):
+        raise ValueError('prepared shader libraries are missing')
+    dest = product / 'msl'
+    if dest.exists():
+        shutil.rmtree(dest)
+    dest.mkdir()
+    if shaders.is_dir():
+        shutil.copytree(shaders, dest / folder)
+    else:
+        shutil.copyfile(shaders, dest / (folder + '.img'))
+    pso = paths.get('DM_RESOURCE_PSO', '')
+    dest = product / 'pso'
+    if dest.exists():
+        shutil.rmtree(dest)
+    if pso:
+        shutil.copytree(pso, dest)
+    icon = gen / 'Assets.xcassets/AppIcon.appiconset/icon.png'
+    if icon.is_file():
+        shutil.copyfile(icon, product / 'icon.png')
+    elif (product / 'icon.png').exists():
+        (product / 'icon.png').unlink()
+
+
+def main() -> None:
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument('workspace', type=Path)
+    parser.add_argument('--stage-products', action='store_true')
+    args = parser.parse_args()
+    try:
+        if args.stage_products:
+            stage_products(args.workspace.resolve())
+            return
+        result = prepare(Path(__file__).resolve().parents[1], args.workspace)
+    except (OSError, ValueError, KeyError) as exc:
+        parser.error(str(exc))
+    print(json.dumps(result, sort_keys=True))
+
+
+if __name__ == '__main__':
+    main()
