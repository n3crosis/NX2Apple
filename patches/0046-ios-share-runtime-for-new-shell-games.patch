+def build_shared_shell_framework(repo, work, destination, title_id, env, logs, on_line):
+    """Reuse the prepared route-C workspace and shared-runtime builder, never a second importer."""
+    workspace = work / 'shared-xcode'
+    prepared = dict(env, DM_FRAMEWORK='1', DM_FRAMEWORK_NAME='DmGame' + title_id.upper(),
+                    DM_FRAMEWORK_ONLY='', DM_COPY_ROMFS='NO', DM_XCODE_PROJECT_DIR=str(workspace))
+    run(['bash', repo / 'dm/ios/tools/build_ipa.sh', '--prepare-xcode'],
+        logs / 'prepare_shared_runtime.log', env=prepared, on_line=on_line)
+    run(['bash', repo / 'dm/ios/tools/build_shared_runtime.sh', workspace],
+        logs / 'build_shared_runtime.log', env=prepared, on_line=on_line)
+    products = workspace / 'shared-build/Release-iphoneos'
+    names = ['DmGame' + title_id.upper(), 'DmSharedRuntime']
+    for name in names:
+        framework = products / (name + '.framework')
+        receipt = 'shared-runtime.json' if name == 'DmSharedRuntime' else 'game.manifest.json'
+        if not (framework / name).is_file() or not (framework / receipt).is_file():
+            raise BuildError(f'incomplete shared-runtime product: {framework}')
+    destination.mkdir(parents=True, exist_ok=True)
+    # Stage on the destination volume so publication and rollback use renames,
+    # not copies. Keep the old pair until both new products have been published.
+    stage = Path(tempfile.mkdtemp(prefix='.shared-stage-', dir=destination))
+    backups, installed = [], []
+    cleanup = True
+    try:
+        for name in names:
+            shutil.copytree(products / (name + '.framework'), stage / (name + '.framework'))
+        try:
+            for name in names:
+                target = destination / (name + '.framework')
+                if target.exists() or target.is_symlink():
+                    backup = stage / (target.name + '.previous')
+                    target.rename(backup)
+                    backups.append((target, backup))
+                (stage / target.name).rename(target)
+                installed.append(target)
+        except BaseException:
+            try:
+                for target in reversed(installed):
+                    target.rename(stage / target.name)
+                for target, backup in reversed(backups):
+                    backup.rename(target)
+            except BaseException as recovery_error:
+                # Never erase the only old copy if a filesystem error also blocks
+                # recovery. Leave its location in the error for a manual retry.
+                cleanup = False
+                raise BuildError(f'shared-runtime rollback failed; recovery files preserved at {stage}: {recovery_error}') from recovery_error
+            raise
+    finally:
+        if cleanup:
+            rmtree(stage)
+
