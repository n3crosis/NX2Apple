+"""Portable FS build boundary tests; no Apple SDK or copyrighted game inputs."""
+import importlib.util
+import json
+from pathlib import Path
+import shutil
+import subprocess
+import tempfile
+import unittest
+
+IOS = Path(__file__).resolve().parents[1]
+spec = importlib.util.spec_from_file_location('shared_build', IOS / 'tools/gen_shared_runtime.py')
+shared = importlib.util.module_from_spec(spec)
+spec.loader.exec_module(shared)
+
+
+class SharedBuildTests(unittest.TestCase):
+    def setUp(self):
+        self.tmp = tempfile.TemporaryDirectory()
+        self.addCleanup(self.tmp.cleanup)
+        self.root = Path(self.tmp.name)
+        self.ios = self.root / 'dm/ios'
+        for p in ('tools', 'Sources', 'framework'):
+            (self.ios / p).mkdir(parents=True)
+        for name in ('gen_objc_namespace.py', 'gen_shared_runtime.py'):
+            shutil.copyfile(IOS / 'tools' / name, self.ios / 'tools' / name)
+        shutil.copyfile(IOS / 'project-shared-runtime.yml', self.ios / 'project-shared-runtime.yml')
+        (self.ios.parent / 'host').mkdir()
+        (self.ios.parent / 'host/host.c').write_text('void runtime(void) {}\n')
+        (self.ios / 'Sources/front_ios.m').write_text('@implementation DmRootVC\n@end\n')
+        chain = self.ios.parent / 'gfx/nvn/dmsh_chain.h'
+        chain.parent.mkdir(parents=True)
+        chain.write_text('#define DMSH_CHAIN "0123456789ab"\n')
+        self.ws = self.root / 'workspace'
+        self.gen = self.ws / 'Gen'
+        for p in ('src', 'main', 'framework/dm'):
+            (self.gen / p).mkdir(parents=True)
+        for p in ('embed.S', 'main/main.c', 'framework/profile.tsv'):
+            (self.gen / p).write_text('')
