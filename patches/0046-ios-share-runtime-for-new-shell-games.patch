+#define DM_DESCRIPTOR dm_shared_game_descriptor
+#elif defined(DM_SHARED_RUNTIME_BUILD)
+#define DM_DESCRIPTOR dm_shared_runtime_descriptor
+#else
+#error SharedRuntime.c belongs only to the FS targets
+#endif
