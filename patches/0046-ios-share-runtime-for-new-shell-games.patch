--- a/dm/host/hle_profile.c
+++ b/dm/host/hle_profile.c
@@ -127,6 +127,14 @@ static uint64_t num(const char *v, uint64_t dflt) {
 #endif
 static void defaults(void) {
     memset(&P, 0, sizeof P);
+#ifdef DM_SHARED_RUNTIME_BUILD
+    // A shared host must never inherit the game used to prepare its build inputs.
+    // FS requires a generated profile; absent optional keys have neutral defaults.
