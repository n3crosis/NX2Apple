--- a/dm/ios/framework/ShellGlue.m
+++ b/dm/ios/framework/ShellGlue.m
@@ -11,6 +11,9 @@
 #include <string.h>
 #include <sys/stat.h>
 #include "front.h"
+#ifdef DM_SHARED_RUNTIME_BUILD
+#include "hle_profile.h"
+#endif
 #include "ShellGlue.h"
 
 int dm_main(int argc, char **argv);   // dm/host/main.c compiled in with -Dmain=dm_main
@@ -26,6 +29,17 @@ static int g_boot_ok;
 __attribute__((used, visibility("default")))
 const char *dm_glue_start_game(const char *const *argv, int argc, const void *game_image) {
     if (argc < 2 || !game_image) return "The game's start arguments are incomplete.";
+#ifdef DM_SHARED_RUNTIME_BUILD
+    // Do not start threads, make a device, or install the game image until the
+    // runtime profile is readable and supplies the essential game identity/layout.
+    const char *profile = getenv("DM_PROFILE");
+    FILE *pf = profile && *profile ? fopen(profile, "r") : NULL;
+    if (!pf) return "The shared-runtime game profile is missing or unreadable.";
+    fclose(pf);
+    const struct dm_profile *p = dm_profile();
+    if (!p->id[0] || !p->program_id || p->nmod <= 0 || !p->mem_reserve || !p->mem_stack)
+        return "The shared-runtime game profile is incomplete.";
+#endif
     front_hud_env();   // before the early loading below can make a device (main.m's order)
     dm_set_game_image_header(game_image);
     for (int i = 0; i < g_argc; i++) free(g_argv[i]);
