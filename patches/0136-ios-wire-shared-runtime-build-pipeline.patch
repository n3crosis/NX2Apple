diff --git a/dm/ios/tests/test_shared_runtime_pipeline.py b/dm/ios/tests/test_shared_runtime_pipeline.py
new file mode 100644
--- /dev/null
+++ b/dm/ios/tests/test_shared_runtime_pipeline.py
@@ -0,0 +1,97 @@
+"""Exercise FS pipeline orchestration without Xcode or game data."""
+import ast
+from pathlib import Path
+import shutil
+import tempfile
+import unittest
+
+SCRIPT = Path(__file__).resolve().parents[3] / 'scripts/build_ipa_from_nsp.py'
+
+
+class SharedRuntimePipelineTests(unittest.TestCase):
+    def setUp(self):
+        self.tmp = tempfile.TemporaryDirectory()
+        self.addCleanup(self.tmp.cleanup)
+        self.root = Path(self.tmp.name)
+        self.work = self.root / 'work'
+        self.output = self.work / 'shell-framework'
+        self.title = '0100123456789000'
+        self.names = ['DmGame' + self.title, 'DmSharedRuntime']
+        self.calls = []
+        self.missing = None
+        self.failed = False
+        def run(cmd, log, env, on_line):
+            self.calls.append((cmd, log, dict(env)))
+            if str(cmd[1]).endswith('build_shared_runtime.sh'):
+                if self.failed:
+                    raise RuntimeError('Xcode failed')
+                for name in self.names:
+                    product = self.work / 'shared-xcode/shared-build/Release-iphoneos' / (name + '.framework')
+                    product.mkdir(parents=True)
+                    (product / name).write_text('new')
+                    if name != self.missing:
+                        (product / ('shared-runtime.json' if name == 'DmSharedRuntime' else 'game.manifest.json')).write_text('{}')
+        tree = ast.parse(SCRIPT.read_text())
+        node = next(n for n in tree.body if isinstance(n, ast.FunctionDef) and n.name == 'build_shared_shell_framework')
+        ns = dict(Path=Path, shutil=shutil, tempfile=tempfile, run=run, BuildError=ValueError,
+                  rmtree=lambda p: shutil.rmtree(p) if p.exists() else None)
+        exec(compile(ast.Module(body=[node], type_ignores=[]), str(SCRIPT), 'exec'), ns)
+        self.build = ns[node.name]
+
+    def invoke(self):
+        self.build(self.root / 'engine', self.work, self.output, self.title,
+                   {'DM_FRAMEWORK_ONLY': str(self.output), 'KEEP': 'unchanged'}, self.work / 'logs', None)
+
+    def seed_legacy(self):
+        old = self.output / (self.names[0] + '.framework')
+        old.mkdir(parents=True)
+        (old / 'legacy-only').write_text('FH')
+        other = self.output / 'DmGameOTHER.framework'
+        other.mkdir()
+        (other / 'keep').write_text('FH')
+        return old, other
+
+    def test_reuses_existing_prepare_and_shared_builder_and_stages_both_products(self):
+        old, other = self.seed_legacy()
+        self.invoke()
+        self.assertEqual(len(self.calls), 2)
+        self.assertEqual(self.calls[0][0][-1], '--prepare-xcode')
+        self.assertTrue(str(self.calls[1][0][1]).endswith('/build_shared_runtime.sh'))
+        env = self.calls[0][2]
+        self.assertEqual(env['DM_FRAMEWORK_ONLY'], '')
+        self.assertEqual(env['DM_FRAMEWORK'], '1')
+        self.assertEqual(env['DM_FRAMEWORK_NAME'], self.names[0])
+        self.assertEqual(env['DM_COPY_ROMFS'], 'NO')
+        self.assertEqual(env['KEEP'], 'unchanged')
+        self.assertFalse((old / 'legacy-only').exists())
+        self.assertEqual((other / 'keep').read_text(), 'FH')
+        for name in self.names:
+            self.assertEqual((self.output / (name + '.framework') / name).read_text(), 'new')
+
+    def test_incomplete_product_does_not_replace_legacy_framework(self):
+        old, _ = self.seed_legacy()
+        self.missing = 'DmSharedRuntime'
+        with self.assertRaisesRegex(ValueError, 'incomplete'):
+            self.invoke()
+        self.assertEqual((old / 'legacy-only').read_text(), 'FH')
+
+    def test_build_failure_does_not_replace_legacy_framework(self):
+        old, _ = self.seed_legacy()
+        self.failed = True
+        with self.assertRaisesRegex(RuntimeError, 'Xcode failed'):
+            self.invoke()
+        self.assertEqual((old / 'legacy-only').read_text(), 'FH')
+
+    def test_flag_is_opt_in_and_requires_shell_framework(self):
+        tree = ast.parse(SCRIPT.read_text())
+        source = SCRIPT.read_text()
+        call = next(n for n in ast.walk(tree) if isinstance(n, ast.Call) and n.args
+                    and isinstance(n.args[0], ast.Constant) and n.args[0].value == '--shared-runtime')
+        self.assertEqual(next(k.value.value for k in call.keywords if k.arg == 'action'), 'store_true')
+        self.assertIn("if args.shared_runtime and not shell_fw: raise BuildError", source)
+        self.assertIn("if args.shared_runtime and programs: raise BuildError", source)
+        self.assertIn("else:\n            run(['bash', repo / 'dm/ios/tools/build_ipa.sh'], logs / 'build_framework.log'", source)
+
+
+if __name__ == '__main__':
+    unittest.main()
