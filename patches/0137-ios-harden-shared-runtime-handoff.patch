+    def test_cancellation_restores_legacy_game(self):
+        old, _ = self.seed_legacy()
+        rename = Path.rename
+        def cancel_runtime(source, target):
+            if Path(target) == self.output / 'DmSharedRuntime.framework':
+                raise KeyboardInterrupt()
+            return rename(source, target)
+        with mock.patch.object(Path, 'rename', cancel_runtime):
+            with self.assertRaises(KeyboardInterrupt):
+                self.invoke()
+        self.assertEqual((old / 'legacy-only').read_text(), 'FH')
+        self.assertFalse((self.output / 'DmSharedRuntime.framework').exists())
+        self.assertFalse(list(self.output.glob('.shared-stage-*')))
+
+    def test_failed_rollback_preserves_recovery_files(self):
+        old, _ = self.seed_legacy()
