+                runtime.mkdir()
+                (runtime / 'previous').write_text('old runtime')
+                rename = Path.rename
+                calls = 0
+                def fail_once(source, target):
+                    nonlocal calls
+                    calls += 1
+                    if calls == failed_move:
+                        raise OSError('injected rename failure')
+                    return rename(source, target)
+                with mock.patch.object(Path, 'rename', fail_once):
+                    with self.assertRaisesRegex(OSError, 'injected rename failure'):
+                        self.invoke()
+                self.assertEqual((old / 'legacy-only').read_text(), 'FH')
+                self.assertEqual((runtime / 'previous').read_text(), 'old runtime')
+                self.assertEqual((other / 'keep').read_text(), 'FH')
