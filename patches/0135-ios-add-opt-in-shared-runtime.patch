diff --git a/dm/ios/Shell/SharedRuntime.h b/dm/ios/Shell/SharedRuntime.h
new file mode 100644
index 0000000..4216a45
--- /dev/null
+++ b/dm/ios/Shell/SharedRuntime.h
@@ -0,0 +1,14 @@
+// FS is opt-in. FH keeps its existing ShellGlue.h ABI and embedded host.
+#pragma once
+#include <stdint.h>
+#define DM_SHARED_RUNTIME_ABI 1u
+#define DM_SHARED_PROFILE_ABI 1u
+// The pointed-to strings and this descriptor live for the lifetime of their image.
+// Validate all fields before entering host code. runtime_version identifies the
+// exact runtime sources, not just the public function signatures.
+typedef struct dm_shared_descriptor {
+    uint32_t abi;
+    uint32_t profile_abi;
+    const char *runtime_version;
+    const char *shader_chain;
+} dm_shared_descriptor;
diff --git a/dm/ios/Shell/SharedRuntimeChecks.h b/dm/ios/Shell/SharedRuntimeChecks.h
new file mode 100644
index 0000000..2c861f6
--- /dev/null
+++ b/dm/ios/Shell/SharedRuntimeChecks.h
@@ -0,0 +1,15 @@
+// Strict shared-runtime compatibility gates. FH uses its existing glue version check.
+#ifndef DM_SHARED_RUNTIME_CHECKS_H
+#define DM_SHARED_RUNTIME_CHECKS_H
+#include "SharedRuntime.h"
+#include <string.h>
+static inline int shared_descriptor_valid(const dm_shared_descriptor *d) {
+    return d && d->abi == DM_SHARED_RUNTIME_ABI && d->profile_abi == DM_SHARED_PROFILE_ABI &&
+        d->runtime_version && d->runtime_version[0] && d->shader_chain && d->shader_chain[0];
+}
+static inline int shared_descriptors_match(const dm_shared_descriptor *game, const dm_shared_descriptor *runtime) {
+    return shared_descriptor_valid(game) && shared_descriptor_valid(runtime) &&
+        !strcmp(game->runtime_version, runtime->runtime_version) &&
+        !strcmp(game->shader_chain, runtime->shader_chain);
+}
+#endif
