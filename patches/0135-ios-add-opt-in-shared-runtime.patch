+#!/bin/bash
+# Opt-in FS build, using a DM_FRAMEWORK=1 tools/build_ipa.sh --prepare-xcode workspace.
+# Usage: build_shared_runtime.sh WORKSPACE [--prepare-only]
+# Produces unsigned frameworks in WORKSPACE/shared-build/Release-iphoneos.
+set -eu
+[ "$#" -ge 1 ] && [ "$#" -le 2 ] || { echo 'usage: build_shared_runtime.sh WORKSPACE [--prepare-only]' >&2; exit 2; }
+MODE=${2:-}
+[ -z "$MODE" ] || [ "$MODE" = --prepare-only ] || { echo "unknown mode: $MODE" >&2; exit 2; }
+IOS=$(cd "$(dirname "$0")/.." && pwd)
+W=$(cd "$1" && pwd)
+python3 "$IOS/tools/gen_shared_runtime.py" "$W"
+cd "$W"
+xcodegen generate --spec project-shared-runtime.yml
+[ "$MODE" != --prepare-only ] || exit 0
+for TARGET in DmSharedRuntime DmSharedGame; do
+    xcodebuild -project DmShared.xcodeproj -target "$TARGET" -configuration Release -sdk iphoneos \
+        CODE_SIGNING_ALLOWED=NO CODE_SIGNING_REQUIRED=NO CODE_SIGN_IDENTITY= \
+        SYMROOT="$W/shared-build" OBJROOT="$W/shared-build/Intermediates.noindex" build
+done
+python3 "$IOS/tools/gen_shared_runtime.py" "$W" --stage-products
+printf 'Unsigned FS frameworks: %s/shared-build/Release-iphoneos\n' "$W"
