+# Opt-in FS targets. Generated into an existing prepared workspace by gen_shared_runtime.py.
+# No dependency on each other: the shell loads both images explicitly with RTLD_LOCAL.
+name: DmShared
+options:
+  deploymentTarget:
+    iOS: '26.0'
+settings:
+  base:
+    CODE_SIGNING_ALLOWED: NO
+    CODE_SIGNING_REQUIRED: NO
+    CODE_SIGN_IDENTITY: ''
+    SKIP_INSTALL: YES
+    ENABLE_BITCODE: NO
+    DEFINES_MODULE: NO
+    GCC_C_LANGUAGE_STANDARD: gnu11
+    CLANG_ENABLE_OBJC_ARC: YES
+    DYLIB_INSTALL_NAME_BASE: '@rpath'
+    MARKETING_VERSION: '1.0'
+    CURRENT_PROJECT_VERSION: '1'
+    DEBUG_INFORMATION_FORMAT: dwarf
+    SWIFT_VERSION: '5.0'
+targets:
+  DmSharedRuntime:
+    type: framework
+    platform: iOS
+    configFiles:
+      Debug: Gen/shared/runtime.xcconfig
+      Release: Gen/shared/runtime.xcconfig
+    sources:
+      - path: Gen/src
+      - path: Gen/main/main.c
+        compilerFlags: '-Dmain=dm_main'
+      - path: framework/ShellGlue.m
+      - path: framework/SharedRuntime.c
+      - path: Sources/front_ios.m
+      - path: Sources/DmGamepad.m
+      - path: Sources/GameMenu.swift
+      - path: Sources/LauncherSettings.swift
+      - path: Sources/CloudSaves.m
+      - path: Sources/SaveSync.m
+      - path: Sources/DataBookmark.m
+      - path: Gen/shared/shared-runtime.json
+        buildPhase: resources
+    info:
+      path: Gen/shared/Runtime-Info.plist
+      properties:
+        DMSharedRuntimeABI: 1
+        DMSharedProfileABI: 1
+        DMSharedRuntimeVersion: __RUNTIME_VERSION__
+        DMChain: __CHAIN__
+    settings:
+      PRODUCT_NAME: DmSharedRuntime
+      PRODUCT_MODULE_NAME: DmSharedRuntime
+      PRODUCT_BUNDLE_IDENTIFIER: org.nxnative.shared-runtime
+      OTHER_CFLAGS: $(inherited) -mcpu=apple-a18 -DDM_SHARED_RUNTIME_BUILD=1 -include "$(SRCROOT)/Gen/shared/objc_namespace.h"
+      OTHER_SWIFT_FLAGS: $(inherited) -Xcc -include -Xcc "$(SRCROOT)/Gen/shared/objc_namespace.h" -import-objc-header "$(SRCROOT)/Sources/DmGameMenu.h"
+      OTHER_LDFLAGS: $(inherited) -framework UIKit -framework UserNotifications -Wl,-exported_symbols_list,"$(SRCROOT)/Gen/shared/runtime.exports"
+  DmSharedGame:
+    type: framework
+    platform: iOS
+    configFiles:
+      Debug: Gen/shared/game.xcconfig
+      Release: Gen/shared/game.xcconfig
+    sources:
+      - path: Gen/embed.S
+      - path: framework/DmGameMarker.m
+      - path: framework/SharedRuntime.c
+      - path: Gen/shared/dm
+        type: folder
+        buildPhase: resources
+      - path: Gen/framework/profile.tsv
+        buildPhase: resources
+      - path: Gen/shared/game.manifest.json
+        buildPhase: resources
+    info:
+      path: Gen/shared/Game-Info.plist
+    settings:
+      PRODUCT_NAME: __GAME_PRODUCT__
+      PRODUCT_BUNDLE_IDENTIFIER: org.nxnative.game.__TITLE_ID__
+      OTHER_CFLAGS: $(inherited) -mcpu=apple-a18 -DDM_SHARED_GAME_BUILD=1
+      OTHER_LDFLAGS: $(inherited) -Wl,-exported_symbols_list,"$(SRCROOT)/Gen/shared/game.exports"
