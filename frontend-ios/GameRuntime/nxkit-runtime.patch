+            Ok(())
+        } else {
+            Err(format!("{what} failed with status {status}"))
+        }
+    }
+
+    impl Output {
+        /// Starts stereo 48 kHz output through the host's active audio session.
+        pub fn start(fill: Fill) -> Result<Self, String> {
+            let desc = AudioComponentDescription {
+                componentType: 0x6175_6f75,
+                componentSubType: 0x7269_6f63,
+                componentManufacturer: 0x6170_706c,
+                componentFlags: 0,
+                componentFlagsMask: 0,
+            };
+            // SAFETY: a valid description and null starting component.
+            let component = unsafe { AudioComponentFindNext(std::ptr::null_mut(), &desc) };
+            if component.is_null() {
+                return Err("no RemoteIO output component".to_string());
+            }
+            let mut unit = std::ptr::null_mut();
+            // SAFETY: component is live and unit receives the new instance.
+            check("create the output unit", unsafe {
+                AudioComponentInstanceNew(component, &mut unit)
+            })?;
+            let output = Self {
+                unit,
+                fill: Box::into_raw(Box::new(fill)),
+            };
+            let format = AudioStreamBasicDescription {
+                mSampleRate: 48000.0,
+                mFormatID: 0x6c70_636d,
+                mFormatFlags: 1 | 8,
+                mBytesPerPacket: 8,
+                mFramesPerPacket: 1,
+                mBytesPerFrame: 8,
+                mChannelsPerFrame: 2,
+                mBitsPerChannel: 32,
+                mReserved: 0,
+            };
+            // SAFETY: format points to a complete ASBD; input scope, output bus 0.
+            check("set the stream format", unsafe {
+                AudioUnitSetProperty(
+                    unit,
+                    8,
+                    1,
+                    0,
+                    std::ptr::from_ref(&format).cast(),
+                    std::mem::size_of_val(&format) as u32,
+                )
+            })?;
+            #[repr(C)]
+            struct Callback {
+                proc_: *const c_void,
+                refcon: *mut c_void,
+            }
+            let callback = Callback {
+                proc_: render as *const c_void,
+                refcon: output.fill.cast(),
+            };
+            // SAFETY: callback matches AURenderCallbackStruct and remains valid through output.
+            check("set the render callback", unsafe {
+                AudioUnitSetProperty(
+                    unit,
+                    23,
+                    0,
+                    0,
+                    std::ptr::from_ref(&callback).cast(),
+                    std::mem::size_of_val(&callback) as u32,
+                )
+            })?;
+            // SAFETY: unit is configured and owned by output.
+            check("initialize the output unit", unsafe {
+                AudioUnitInitialize(unit)
+            })?;
+            // SAFETY: unit is initialized and its callback context is retained.
+            check("start the output unit", unsafe {
+                AudioOutputUnitStart(unit)
+            })?;
+            Ok(output)
+        }
+
+        /// Stops or restarts callbacks while retaining the configured output unit.
+        pub fn set_paused(&mut self, paused: bool) -> Result<(), String> {
+            // SAFETY: the mixer serializes control operations on this owned unit.
+            let status = unsafe {
+                if paused {
+                    AudioOutputUnitStop(self.unit)
+                } else {
+                    AudioOutputUnitStart(self.unit)
+                }
+            };
+            check("change the output unit state", status)
+        }
+
+        /// RemoteIO manages its render thread; no HAL workgroup is joined.
+        pub fn join_status(&self) -> Option<i32> {
+            None
+        }
+    }
+
+    impl Drop for Output {
+        fn drop(&mut self) {
+            // SAFETY: the unit is owned here. Disposing it ends callbacks before freeing their context.
+            unsafe {
+                AudioOutputUnitStop(self.unit);
+                AudioUnitUninitialize(self.unit);
+                AudioComponentInstanceDispose(self.unit);
+                drop(Box::from_raw(self.fill));
+            }
+        }
+    }
+}
