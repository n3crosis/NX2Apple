+    let addr = w.addr(0);
+    let owner = w.main.handle();
+    w.store(0, owner | nxkit_hos::WAITERS_BIT);
+    let k = w.kernel.clone();
+    let (tx, rx) = std::sync::mpsc::channel();
+    let h = w.spawn("sleeper", 30, 0, move |t| {
+        k.close_handle(t.handle()).expect("close own handle");
+        k.sleep_thread(t, 60_000_000_000);
