+#[test]
+fn cancel_all_sync_waits_handles_closed_threads_and_removes_registrations() {
+    let w = world();
+    let (_, r1) = w.kernel.create_event().expect("event");
+    let (_, r2) = w.kernel.create_event().expect("event");
+    let k = w.kernel.clone();
+    let (tx, rx) = std::sync::mpsc::channel();
+    let (cancelled, release) = std::sync::mpsc::channel();
+    w.spawn("waiter", 30, 0, move |t| {
+        k.close_handle(t.handle()).expect("close own handle");
+        let refs = Arc::strong_count(t);
+        let result = k.wait_synchronization(t, &[r1, r2], Timeout::Infinite);
+        release
+            .recv_timeout(Duration::from_secs(2))
+            .expect("cancellation finished");
+        tx.send((result, refs, Arc::strong_count(t)))
+            .expect("result");
+    });
+    w.wait_until("parked", || w.blocked() >= 1);
+    w.kernel.close_thread_admission();
+    w.kernel.cancel_synchronization_waits();
+    cancelled.send(()).expect("release reference check");
+    let (result, before, after) = rx.recv_timeout(Duration::from_secs(2)).expect("cancelled");
+    assert_eq!(result, Err(KResult::CANCELLED));
+    assert_eq!(before, after, "event queues retain no waiter references");
+    assert_eq!(
+        w.kernel
+            .wait_synchronization(&w.main, &[r1], Timeout::Immediate),
+        Err(KResult::CANCELLED),
+        "a thread not yet waiting receives the pending cancellation"
+    );
+}
