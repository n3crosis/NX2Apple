+    let w = world();
+    let addr = w.addr(0);
+    let owner = w.main.handle();
+    w.store(0, owner | nxkit_hos::WAITERS_BIT);
+    let k = w.kernel.clone();
+    let (tx, rx) = std::sync::mpsc::channel();
+    let waiter = w.spawn("lock waiter", 30, 0, move |t| {
+        tx.send(k.arbitrate_lock(t, owner, addr, t.handle()))
+            .expect("result");
+    });
+    w.wait_until("lock waiter parked", || w.blocked() >= 1);
+    w.kernel.cancel_synchronization_waits();
+    let early = rx.recv_timeout(Duration::from_millis(30));
+    assert_eq!(w.kernel.arbitrate_unlock(addr), Ok(()));
+    assert_eq!(early, Err(std::sync::mpsc::RecvTimeoutError::Timeout));
+    assert_eq!(
