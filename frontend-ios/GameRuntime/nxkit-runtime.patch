+++ b/crates/nxkit-host/src/sys/ios_ffi.rs
@@ -0,0 +1,246 @@
+//! C calls for the single UIKit game view. Preparation may run off the main thread.
+
+use std::cell::RefCell;
+use std::ffi::{CStr, c_char, c_void};
+use std::panic::{AssertUnwindSafe, catch_unwind};
+use std::path::Path;
+use std::ptr::NonNull;
+
+use objc2::MainThreadMarker;
+
+use super::ios::{GameView, PreparedGame};
+use std::sync::Mutex;
+
+static PREPARED: Mutex<Option<PreparedGame>> = Mutex::new(None);
+use crate::refresh::ScreenFacts;
+
+thread_local! {
+    static VIEW: RefCell<Option<GameView>> = const { RefCell::new(None) };
+}
+
+unsafe fn call(
+    main_thread: bool,
+    error: *mut c_char,
+    capacity: usize,
+    f: impl FnOnce() -> Result<(), String>,
+) -> i32 {
+    let result = if main_thread && MainThreadMarker::new().is_none() {
+        Err("runtime calls must use the main thread".into())
+    } else {
+        catch_unwind(AssertUnwindSafe(f)).unwrap_or_else(|_| Err("runtime panicked".into()))
+    };
+    let (code, message) = match result {
+        Ok(()) => (0, String::new()),
+        Err(message) => (1, message),
+    };
+    if !error.is_null() && capacity > 0 {
+        let count = message.len().min(capacity - 1);
+        // SAFETY: the caller provides a writable buffer of capacity bytes.
+        unsafe {
+            std::ptr::copy_nonoverlapping(message.as_ptr(), error.cast(), count);
+            *error.add(count) = 0;
+        }
+    }
+    code
+}
+
+fn with_view(f: impl FnOnce(&GameView)) -> Result<(), String> {
+    VIEW.with(|cell| {
+        let view = cell.borrow();
+        let view = view.as_ref().ok_or("no game view is attached")?;
+        f(view);
+        Ok(())
+    })
+}
+
+#[unsafe(no_mangle)]
+unsafe extern "C" fn nxkit_ios_prepare(
+    root: *const c_char,
+    writable: *const c_char,
+    error: *mut c_char,
+    capacity: usize,
+) -> i32 {
+    // SAFETY: the caller supplies valid UTF-8 C strings and the documented error buffer.
+    unsafe {
+        call(false, error, capacity, || {
+            if root.is_null() || writable.is_null() {
+                return Err("game paths are null".into());
+            }
+            let root = CStr::from_ptr(root).to_str().map_err(|e| e.to_string())?;
+            let writable = CStr::from_ptr(writable)
+                .to_str()
+                .map_err(|e| e.to_string())?;
+            let game = PreparedGame::new(Path::new(root), Path::new(writable))
+                .map_err(|e| e.to_string())?;
+            *PREPARED.lock().map_err(|_| "prepared game lock poisoned")? = Some(game);
+            Ok(())
+        })
+    }
+}
+
+#[unsafe(no_mangle)]
+unsafe extern "C" fn nxkit_ios_attach(
+    layer: *mut c_void,
+    width: u32,
+    height: u32,
+    max_fps: u32,
+    adaptive: i32,
+    error: *mut c_char,
+    capacity: usize,
+) -> i32 {
+    // SAFETY: the caller supplies a live CAMetalLayer and the documented error buffer.
+    unsafe {
+        call(true, error, capacity, || {
+            let layer = NonNull::new(layer).ok_or("Metal layer is null")?;
+            let game = PREPARED
+                .lock()
+                .map_err(|_| "prepared game lock poisoned")?
+                .take()
+                .ok_or("no prepared game")?;
+            let screen = ScreenFacts {
+                name: "UIKit".into(),
+                display: None,
+                max_fps,
+                adaptive: adaptive != 0,
+            };
+            let view =
+                GameView::attach(game, layer, width, height, &screen).map_err(|e| e.to_string())?;
+            VIEW.with(|cell| *cell.borrow_mut() = Some(view));
+            Ok(())
+        })
+    }
+}
+
+#[unsafe(no_mangle)]
+unsafe extern "C" fn nxkit_ios_set_pad(
+    buttons: u64,
+    lx: f32,
+    ly: f32,
+    rx: f32,
+    ry: f32,
+    error: *mut c_char,
+    capacity: usize,
+) -> i32 {
+    // SAFETY: the caller supplies the documented error buffer.
+    unsafe {
+        call(true, error, capacity, || {
+            with_view(|_| {
+                nxkit_svc_input::set_virtual_pad(Some(nxkit_svc_input::VirtualPad {
+                    buttons,
+                    axes: [lx, ly, rx, ry],
+                }));
+            })
+        })
+    }
+}
+
+#[unsafe(no_mangle)]
+unsafe extern "C" fn nxkit_ios_resize(
+    width: u32,
+    height: u32,
+    error: *mut c_char,
+    capacity: usize,
+) -> i32 {
+    // SAFETY: the caller provides the documented error buffer.
+    unsafe {
+        call(true, error, capacity, || {
+            with_view(|view| view.resize(width, height))
+        })
+    }
+}
+
+#[unsafe(no_mangle)]
+unsafe extern "C" fn nxkit_ios_set_active(active: i32, error: *mut c_char, capacity: usize) -> i32 {
+    // SAFETY: the caller provides the documented error buffer.
+    unsafe {
+        call(true, error, capacity, || {
+            with_view(|view| view.set_active(active != 0))
+        })
+    }
+}
+
+#[unsafe(no_mangle)]
+unsafe extern "C" fn nxkit_ios_set_audio_paused(
+    paused: i32,
+    error: *mut c_char,
+    capacity: usize,
+) -> i32 {
+    // SAFETY: the caller provides the documented error buffer.
+    unsafe {
+        call(true, error, capacity, || {
+            nxkit_svc_audio::set_output_paused(paused != 0)
+        })
+    }
+}
+
+#[repr(C)]
+struct Touch {
+    id: u32,
+    x: f32,
+    y: f32,
+}
+
+#[unsafe(no_mangle)]
+unsafe extern "C" fn nxkit_ios_set_touches(
+    points: *const Touch,
+    count: usize,
+    error: *mut c_char,
+    capacity: usize,
+) -> i32 {
+    // SAFETY: the caller provides count readable touch records and the documented error buffer.
+    unsafe {
+        call(true, error, capacity, || {
+            if count > 16 || (count != 0 && points.is_null()) {
+                return Err("invalid touch array".into());
+            }
+            let points = if count == 0 {
+                &[]
+            } else {
+                std::slice::from_raw_parts(points, count)
+            };
+            let points: Vec<_> = points
+                .iter()
+                .map(|p| nxkit_svc_input::Touch {
+                    id: p.id,
+                    x: p.x,
+                    y: p.y,
+                })
+                .collect();
+            with_view(|view| view.set_touches(&points))
+        })
+    }
+}
+
+#[unsafe(no_mangle)]
+unsafe extern "C" fn nxkit_ios_detach(error: *mut c_char, capacity: usize) -> i32 {
+    // SAFETY: the caller provides the documented error buffer.
+    unsafe {
+        call(true, error, capacity, || {
+            PREPARED
+                .lock()
+                .map_err(|_| "prepared game lock poisoned")?
+                .take();
+            VIEW.with(|cell| {
+                if let Some(view) = cell.borrow_mut().take() {
+                    view.set_active(false);
+                    // Closing is permanent; background pauses use set_active instead.
+                    // A stop request does not mean existing guest threads have exited.
+                    crate::stop::request("game view closed");
+                }
+            });
+            Ok(())
+        })
+    }
+}
+
+#[unsafe(no_mangle)]
+extern "C" fn nxkit_ios_state() -> i32 {
+    if MainThreadMarker::new().is_none() {
+        return -1;
+    }
+    VIEW.with(|cell| match cell.borrow().as_ref() {
+        None => 0,
+        Some(view) if view.stopped() => 2,
+        Some(_) => 1,
+    })
+}
