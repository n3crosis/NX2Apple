+/// A host overlay controller. Button bits follow nn::hid::NpadButton.
+#[derive(Clone, Copy, Debug, Default)]
+pub struct VirtualPad {
+    /// Buttons 0 through 15.
+    pub buttons: u64,
+    /// Left x/y and right x/y, from -1 to 1. Positive y points up.
+    pub axes: [f32; 4],
+}
+
+/// Sets player one's overlay controller. None disconnects it.
+pub fn set_virtual_pad(pad: Option<VirtualPad>) {
+    with(|input| {
+        input.virtual_pad = pad.map(|p| npad::RawPad {
+            buttons: p.buttons & 0xffff,
+            axes: p.axes.map(|v| {
+                if v.is_finite() {
+                    v.clamp(-1.0, 1.0)
+                } else {
+                    0.0
+                }
+            }),
+        })
+    });
+}
