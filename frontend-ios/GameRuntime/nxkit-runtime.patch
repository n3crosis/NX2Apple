--- /dev/null
+++ b/crates/nxkit-host/src/sys/ios.rs
@@ -0,0 +1,127 @@
+//! One game in a UIKit-owned Metal layer.
+//!
+//! The runtime remains process-scoped. A launch attempt consumes it even if preparation fails.
+//! Dropping the view stops presentation, not guest threads. Restart the process before another game.
+
+use std::ffi::c_void;
+use std::path::Path;
+use std::ptr::NonNull;
+use std::sync::Arc;
+use std::sync::atomic::{AtomicBool, Ordering};
+
+use nxkit_metal::{DisplayLink, FrameHooks, FrameInterval, LinkRate, Presenter};
+use objc2::MainThreadMarker;
+
+use crate::error::{HostError, Result};
+use crate::{prepare, refresh, seams, stop, thread};
+
+static STARTED: AtomicBool = AtomicBool::new(false);
+
+/// The presentation of the one game in this process. Keep it alive while the game is visible.
+pub struct GameView {
+    link: DisplayLink,
+    presenter: Presenter,
+}
+
+/// Prepared runtime state. Build it off the main thread, then attach the view on the main thread.
+pub struct PreparedGame {
+    game: prepare::Prepared,
+    hooks: Arc<dyn FrameHooks>,
+}
+
+impl PreparedGame {
+    /// Loads the game and builds pipelines. The native library must already be signed.
+    /// writable_root holds device-local saves and temporary files, outside the payload.
+    pub fn new(root: &Path, writable_root: &Path) -> Result<Self> {
+        let root = root.canonicalize().map_err(|e| HostError::io(root, &e))?;
+        std::fs::create_dir_all(writable_root).map_err(|e| HostError::io(writable_root, &e))?;
+        let writable_root = writable_root
+            .canonicalize()
+            .map_err(|e| HostError::io(writable_root, &e))?;
+        if writable_root.starts_with(&root) {
+            return Err(HostError::App(
+                "writable storage must be outside the game payload".into(),
+            ));
+        }
+        if STARTED.swap(true, Ordering::AcqRel) {
+            return Err(HostError::App(
+                "restart the process before starting another game".into(),
+            ));
+        }
+        let game = prepare::prepare(&root, &writable_root)?;
+        refresh::configure(refresh::Request::from_settings(&game.settings));
+        let hooks = seams::frame_hooks(
+            &game.ctx,
+            &game.gpu_memory,
+            &root,
+            &game.settings,
+            Some(&writable_root),
+        )?;
+        Ok(Self { game, hooks })
+    }
+}
+
+impl GameView {
+    /// Attaches prepared state to the main UIKit run loop and starts its guest thread.
+    ///
+    /// # Safety
+    ///
+    /// layer must point to a live CAMetalLayer. It is retained by the presenter.
+    pub unsafe fn attach(
+        prepared: PreparedGame,
+        layer: NonNull<c_void>,
+        width: u32,
+        height: u32,
+        screen: &refresh::ScreenFacts,
+    ) -> Result<Self> {
+        let mtm = MainThreadMarker::new()
+            .ok_or_else(|| HostError::App("the game view must attach on the main thread".into()))?;
+        if width == 0 || height == 0 {
+            return Err(HostError::App("the game view has no drawable area".into()));
+        }
+        let PreparedGame { game, hooks } = prepared;
+        // SAFETY: the caller supplies a live CAMetalLayer. The presenter retains it.
+        let presenter = unsafe { Presenter::from_raw_layer(&game.ctx, layer) }
+            .map_err(|e| HostError::App(format!("the presenter: {e}")))?;
+        presenter.resize(width, height);
+        let plan = refresh::apply(screen);
+        let rate = match refresh::vrr_range() {
+            Some(range) => LinkRate::Variable(range),
+            None => LinkRate::Fixed(FrameInterval::from_hz(plan.link_hz)),
+        };
+        let link = DisplayLink::new(mtm, &presenter, rate, hooks);
+        nxkit_svc_input::set_virtual_pad(Some(nxkit_svc_input::VirtualPad::default()));
+        thread::start_main(game.boot, game.layout.main_stack.end())?;
+        // Loaded mappings and service state stay alive for the process, as in the desktop runner.
+        drop(game.loaded);
+        Ok(Self { link, presenter })
+    }
+
+    /// Updates the layer's drawable size in pixels.
+    pub fn resize(&self, width: u32, height: u32) {
+        self.presenter.resize(width, height);
+    }
+
+    /// Pauses presentation and reports foreground state to the game and its input service.
+    pub fn set_active(&self, active: bool) {
+        self.link.set_paused(!active);
+        nxkit_svc_input::set_focus(active);
+        nxkit_svc_system::set_focus(if active {
+            nxkit_svc_system::Focus::InFocus
+        } else {
+            nxkit_svc_input::set_touches(&[]);
+            nxkit_svc_input::set_virtual_pad(Some(nxkit_svc_input::VirtualPad::default()));
+            nxkit_svc_system::Focus::OutOfFocus
+        });
+    }
+
+    /// Updates touch points in normalized game-view coordinates.
+    pub fn set_touches(&self, points: &[nxkit_svc_input::Touch]) {
+        nxkit_svc_input::set_touches(points);
+    }
+
+    /// Whether the guest asked to stop. This does not mean all guest threads have exited.
+    pub fn stopped(&self) -> bool {
+        stop::requested()
+    }
+}
