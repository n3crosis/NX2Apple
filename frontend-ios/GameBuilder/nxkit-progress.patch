+// Bound telemetry on large ROMs while preserving the exact start and finish.
+pub(super) fn counted(
+    report: &dyn Fn(&str) -> bool,
+    name: &str,
+    done: usize,
+    total: usize,
+) -> Result<(), String> {
+    let stride = total.div_ceil(200).max(1);
+    if done == 0 || done == total || done % stride == 0 {
+        stage(report, &format!("{name}:{done}:{total}"))?;
+    }
+    Ok(())
+}
