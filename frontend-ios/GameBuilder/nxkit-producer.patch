+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn stores_canonical_manifest_and_streamed_payload() {
+        let root = std::env::temp_dir().join(format!("nxb-package-{}", std::process::id()));
+        fs::create_dir_all(&root).unwrap();
+        let run = root.join("run");
+        fs::create_dir_all(&run).unwrap();
+        fs::write(
+            run.join("game.json"),
+            br#"{"title_id":"0100000000000000","name":"Fixture","dylib":"nxgame.dylib"}"#,
+        )
+        .unwrap();
+        fs::write(run.join("nxgame.dylib"), [0u8; 32]).unwrap();
+        let metadata = Metadata {
+            runtime_abi: 1,
+            runtime_revision: "a".repeat(40),
+            generation: "12345678-1234-1234-1234-123456789abc".into(),
+            title_id: "0100000000000000".into(),
+            name: "Fixture".into(),
+            min_os: "26.0".into(),
+        };
+        let output = root.join("game.nxb");
+        let _ = fs::remove_file(&output);
+        write(&run, &output, &metadata).unwrap();
+        let mut archive = zip::ZipArchive::new(File::open(&output).unwrap()).unwrap();
+        assert_eq!(archive.len(), 3);
+        let mut manifest = String::new();
+        archive
+            .by_name("nxb.json")
+            .unwrap()
+            .read_to_string(&mut manifest)
+            .unwrap();
+        assert!(manifest.starts_with("{\"architecture\":\"arm64\",\"files\":["));
+        assert!(manifest.contains("\"name\":\"Fixture\""));
+        assert!(!manifest.contains(": "));
+        assert!(manifest.contains("\"runtimeABI\":1"));
+        assert!(!manifest.contains("runtimeAbi"));
+        let mut binary = Vec::new();
+        archive
+            .by_name("run/nxgame.dylib")
+            .unwrap()
+            .read_to_end(&mut binary)
+            .unwrap();
+        assert_eq!(binary, [0u8; 32]);
+        assert!(write(&run, &output, &metadata).is_err());
+        for (algorithm, fixture) in [
+            ("ES256", include_str!("../tests/fixtures/ES256.json")),
+            ("RS256", include_str!("../tests/fixtures/RS256.json")),
+        ] {
+            let proof = nxb_pyjson::parse(fixture).unwrap();
+            let publisher = Publisher {
+                algorithm: algorithm.into(),
+                key_id: proof.get("keyID").unwrap().as_str().unwrap().into(),
+                certificate: Some(proof.get("certificate").unwrap().as_str().unwrap().into()),
+            };
+            let sign = |message: &[u8]| {
+                assert_eq!(
+                    message,
+                    [
+                        format!("NXB-PACKAGE-SIGNATURE-V1\n{}\n", publisher.key_id).as_bytes(),
+                        manifest.as_bytes()
+                    ]
+                    .concat()
+                );
+                Ok(proof
+                    .get("signature")
+                    .unwrap()
+                    .as_str()
+                    .unwrap()
+                    .to_string())
+            };
+            let signed = root.join(format!("{algorithm}.nxb"));
+            write_signed(&run, &signed, &metadata, Some((&publisher, &sign))).unwrap();
+            let mut archive = zip::ZipArchive::new(File::open(signed).unwrap()).unwrap();
+            let mut envelope = String::new();
+            archive
+                .by_name("nxb.signature.json")
+                .unwrap()
+                .read_to_string(&mut envelope)
+                .unwrap();
+            assert_eq!(envelope, fixture.trim_end());
+            let mismatch = Publisher {
+                key_id: "unbound".into(),
+                algorithm: publisher.algorithm.clone(),
+                certificate: publisher.certificate.clone(),
+            };
+            let rejected = root.join(format!("{algorithm}-unbound.nxb"));
+            assert!(write_signed(&run, &rejected, &metadata, Some((&mismatch, &sign))).is_err());
+            assert!(!rejected.exists());
+        }
+        let pinned = Publisher {
+            algorithm: "ES256".into(),
+            key_id: "pinned-key".into(),
+            certificate: None,
+        };
+        let sign = |message: &[u8]| {
+            assert!(message.starts_with(b"NXB-PACKAGE-SIGNATURE-V1\npinned-key\n"));
+            Ok(nxb_pack::plist::base64_encode(&[0; 64]))
+        };
+        let legacy = root.join("pinned.nxb");
+        write_signed(&run, &legacy, &metadata, Some((&pinned, &sign))).unwrap();
+        let mut archive = zip::ZipArchive::new(File::open(legacy).unwrap()).unwrap();
+        let mut proof = String::new();
+        archive
+            .by_name("nxb.signature.json")
+            .unwrap()
+            .read_to_string(&mut proof)
+            .unwrap();
+        assert!(!proof.contains("certificate"));
+        fs::write(run.join("identity.p12"), b"secret").unwrap();
+        let rejected = root.join("rejected.nxb");
+        assert!(write(&run, &rejected, &metadata).is_err());
+        assert!(!rejected.exists());
+        fs::remove_dir_all(root).unwrap();
+    }
+}
