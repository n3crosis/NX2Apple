+    let e = unpack_dlc(&path, title, 2, &out, 64 << 20).unwrap_err();
+    assert!(e.to_string().contains("no RomFS"), "{e}");
+    let mut damaged = build(&[package(2)], false);
+    *damaged.last_mut().unwrap() ^= 1;
+    std::fs::write(&path, damaged).unwrap();
+    let e = unpack_dlc(&path, title, 2, &out, 64 << 20).unwrap_err();
