+    std::fs::write(&path, build(&[package(2), update], false)).unwrap();
+    let e = unpack_dlc(&path, title, 2, &out, 64 << 20).unwrap_err();
+    assert!(e.to_string().contains("addon_update"), "{e}");
+    let absent = Pkg {
+        romfs: None,
