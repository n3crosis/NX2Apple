+#[test]
+fn archive_readers_scan_sparse_large_sources_by_resource() {
+    use nxb_split::src::Src;
+    use std::sync::atomic::{AtomicUsize, Ordering};
+    const SHIFT: u64 = 2 << 30;
+    struct Sparse {
+        original: Vec<u8>,
+        index: Vec<u8>,
+        read: AtomicUsize,
+    }
+    impl Src for Sparse {
+        fn len(&self) -> u64 {
+            30 << 30
+        }
+        fn read_at(&self, offset: u64, bytes: &mut [u8]) -> Result<(), SplitError> {
+            assert!(bytes.len() <= self.original.len(), "whole-archive read");
+            self.read.fetch_add(bytes.len(), Ordering::Relaxed);
+            let (source, offset) = if offset >= SHIFT {
+                (&self.original, offset - SHIFT)
+            } else {
+                (&self.index, offset)
+            };
+            let part = source
+                .get(offset as usize..offset as usize + bytes.len())
+                .ok_or_else(|| SplitError::Red("unexpected sparse range".into()))?;
+            bytes.copy_from_slice(part);
+            Ok(())
+        }
+    }
+    let dir = concat!(env!("CARGO_MANIFEST_DIR"), "/tests/data/");
+    for (name, path) in [
+        ("bnd2", "/n/a.bndl"),
+        ("bnd2_raw", "/n/b.bndl"),
+        ("gf_mixed", "/e/a.gfpak"),
+    ] {
+        let original = std::fs::read(format!("{dir}sm_{name}.bin")).unwrap();
+        let mut index = original.clone();
+        if name.starts_with("bnd2") {
+            for at in (0x18..0x28).step_by(4) {
+                let base = u32::from_le_bytes(index[at..at + 4].try_into().unwrap());
+                index[at..at + 4].copy_from_slice(&(base + SHIFT as u32).to_le_bytes());
+            }
+        } else {
+            let count = u32::from_le_bytes(index[0x10..0x14].try_into().unwrap()) as usize;
+            let table = u64::from_le_bytes(index[0x18..0x20].try_into().unwrap()) as usize;
+            for i in 0..count {
+                let at = table + i * 0x18 + 16;
+                let offset = u64::from_le_bytes(index[at..at + 8].try_into().unwrap());
+                index[at..at + 8].copy_from_slice(&(offset + SHIFT).to_le_bytes());
+            }
+        }
+        let src = Sparse {
+            original,
+            index,
+            read: AtomicUsize::new(0),
+        };
+        let result = nxb_split::scanfile::scan_file(
+            &Profile::default(),
+            &src,
+            path,
+            path,
+            &Env {
+                dicts: &Dicts::new(),
+                common: None,
+                trees: None,
+            },
+            &mut vec![],
+        );
+        assert_eq!(
+            rows(result),
+            std::fs::read_to_string(format!("{dir}sm_{name}.exp")).unwrap()
+        );
+        assert!(src.read.load(Ordering::Relaxed) <= src.original.len() * 2);
+    }
+}
