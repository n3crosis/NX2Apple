diff --git a/crates/nxb-build/src/package.rs b/crates/nxb-build/src/package.rs
new file mode 100644
index 0000000..8ffed44
--- /dev/null
+++ b/crates/nxb-build/src/package.rs
@@ -0,0 +1,480 @@
+//! Streaming schema-2 NXB transport, separate from game preparation and signing.
+
+use std::collections::BTreeSet;
+use std::fs::{self, File};
+use std::io::{Read, Write};
+use std::path::Path;
+
+use nxb_model::Sha256;
+use serde::Serialize;
+use unicode_normalization::UnicodeNormalization;
+use zip::{CompressionMethod, ZipWriter, write::SimpleFileOptions};
+
+/// Runtime compatibility belongs to the consumer. A producer must supply the
+/// actual runtime revision and ABI, not infer compatibility from a bridge API.
+#[derive(Serialize)]
+#[serde(rename_all = "camelCase")]
+pub struct Metadata {
+    /// Payload ABI implemented by the intended runtime.
+    #[serde(rename = "runtimeABI")]
+    pub runtime_abi: u32,
+    /// Exact runtime source revision (40 lowercase hexadecimal characters).
+    pub runtime_revision: String,
+    /// Unique lowercase UUID for this package.
+    pub generation: String,
+    #[serde(rename = "titleID")]
+    /// Nintendo title identifier (16 uppercase hexadecimal characters).
+    pub title_id: String,
+    /// Display name, with no device or account details.
+    pub name: String,
+    #[serde(rename = "minOS")]
+    /// Minimum supported iOS version.
+    pub min_os: String,
+}
+
+#[derive(Serialize)]
+struct Entry {
+    path: String,
+    bytes: u64,
+    sha256: String,
+    executable: bool,
+}
+
+#[derive(Serialize)]
+struct Manifest<'a> {
+    schema: u8,
+    runtime: &'static str,
+    platform: &'static str,
+    architecture: &'static str,
+    #[serde(flatten)]
+    metadata: &'a Metadata,
+    files: &'a [Entry],
+}
+
+/// Public publisher identity included in an optional detached signature envelope.
+#[derive(Serialize)]
+pub struct Publisher {
+    /// ES256 (raw 64-byte r || s signature) or RS256 (PKCS#1 v1.5 SHA-256).
+    pub algorithm: String,
+    /// Lowercase SHA-256 of DER when a certificate is present; otherwise a pinned key ID.
+    #[serde(rename = "keyID")]
+    pub key_id: String,
+    /// Base64 DER X.509 certificate; never its private key.
+    #[serde(skip_serializing_if = "Option::is_none")]
+    pub certificate: Option<String>,
+}
+
+#[derive(Serialize)]
+struct Proof<'a> {
+    version: u8,
+    #[serde(flatten)]
+    publisher: &'a Publisher,
+    signature: String,
+}
+
+/// Packages a prepared, unsigned iOS run directory, without saves or credentials.
+/// The destination must not exist. Failed output is removed; inputs are untouched.
+/// File bytes are streamed and rehashed while writing to detect changed inputs.
+pub fn write(root: &Path, output: &Path, metadata: &Metadata) -> Result<(), String> {
+    write_signed(root, output, metadata, None)
+}
+
+/// Callback returning a base64 signature over the supplied message bytes.
+pub type Signer<'a> = &'a dyn Fn(&[u8]) -> Result<String, String>;
+
+/// A signer owns its private key outside this API. The callback receives the
+/// domain-separated canonical manifest and returns a base64 signature. File
+/// hashes in that manifest cover all game bytes. No certificate-date policy is
+/// imposed here; recipient trust and Apple signing are independent steps.
+pub fn write_signed(
+    root: &Path,
+    output: &Path,
+    metadata: &Metadata,
+    publisher: Option<(&Publisher, Signer<'_>)>,
+) -> Result<(), String> {
+    let fail = |e: std::io::Error| e.to_string();
+    validate_metadata(metadata)?;
+    if !fs::symlink_metadata(root).map_err(fail)?.is_dir() {
+        return Err("payload root must be a real directory".into());
+    }
+    let root = root.canonicalize().map_err(fail)?;
+    let output_parent = output
+        .parent()
+        .filter(|p| !p.as_os_str().is_empty())
+        .unwrap_or(Path::new("."));
+    if output_parent
+        .canonicalize()
+        .map_err(fail)?
+        .starts_with(&root)
+    {
+        return Err("archive destination must be outside the payload root".into());
+    }
+    let root = root.as_path();
+    let mut entries = Vec::new();
+    collect(root, root, &mut entries)?;
+    entries.sort_by(|a, b| a.path.cmp(&b.path));
+    let mut paths = BTreeSet::new();
+    let mut total = 0u64;
+    for entry in &entries {
+        total = total
+            .checked_add(entry.bytes)
+            .ok_or("payload size overflow")?;
+        if !paths.insert(entry.path.to_lowercase()) || total > 128 << 30 {
+            return Err("duplicate paths or oversized payload".into());
+        }
+    }
+    if entries.len() > 65_533
+        || !entries
+            .iter()
+            .any(|e| e.path == "run/game.json" && e.bytes > 0 && e.bytes <= 8 << 20)
+        || !entries
+            .iter()
+            .any(|e| e.path == "run/nxgame.dylib" && e.bytes >= 32 && e.bytes <= 1 << 30)
+    {
+        return Err("payload requires game.json and nxgame.dylib".into());
+    }
+    let game = nxb_pyjson::parse(&fs::read_to_string(root.join("game.json")).map_err(fail)?)
+        .map_err(|e| e.to_string())?;
+    if game.get("title_id").and_then(nxb_pyjson::Value::as_str) != Some(metadata.title_id.as_str())
+        || game.get("name").and_then(nxb_pyjson::Value::as_str) != Some(metadata.name.as_str())
+        || game.get("dylib").and_then(nxb_pyjson::Value::as_str) != Some("nxgame.dylib")
+    {
+        return Err("game identity does not match package metadata".into());
+    }
+    let manifest = serde_jcs::to_vec(&Manifest {
+        schema: 2,
+        runtime: "nxkit",
+        platform: if cfg!(target_abi = "macabi") {
+            "maccatalyst"
+        } else {
+            "ios"
+        },
+        architecture: "arm64",
+        metadata,
+        files: &entries,
+    })
+    .map_err(|e| e.to_string())?;
+    if manifest.len() > 8 << 20 {
+        return Err("oversized manifest".into());
+    }
+    let proof = if let Some((publisher, sign)) = publisher {
+        if !matches!(publisher.algorithm.as_str(), "ES256" | "RS256")
+            || publisher.key_id.is_empty()
+            || publisher.key_id.len() > 128
+            || !publisher
+                .key_id
+                .bytes()
+                .all(|b| b.is_ascii_alphanumeric() || b"._-".contains(&b))
+        {
+            return Err("invalid publisher metadata".into());
+        }
+        if let Some(encoded) = &publisher.certificate {
+            if encoded.is_empty() || encoded.len() > 48 << 10 {
+                return Err("invalid publisher certificate size".into());
+            }
+            let certificate = nxb_pack::plist::base64_decode(encoded).map_err(|e| e.to_string())?;
+            if certificate.is_empty() || nxb_pack::plist::base64_encode(&certificate) != *encoded {
+                return Err("publisher certificate must be canonical base64 DER".into());
+            }
+            let mut hash = Sha256::new();
+            hash.update(&certificate);
+            if publisher.key_id != hash.finalize().to_string() {
+                return Err("publisher key ID must match certificate SHA-256".into());
+            }
+        }
+        let mut message = format!("NXB-PACKAGE-SIGNATURE-V1\n{}\n", publisher.key_id).into_bytes();
+        message.extend_from_slice(&manifest);
+        let signature = sign(&message)?;
+        let signature_bytes =
+            nxb_pack::plist::base64_decode(&signature).map_err(|e| e.to_string())?;
+        if nxb_pack::plist::base64_encode(&signature_bytes) != signature
+            || (publisher.algorithm == "ES256" && signature_bytes.len() != 64)
+            || (publisher.algorithm == "RS256" && !(256..=1024).contains(&signature_bytes.len()))
+        {
+            return Err("invalid publisher signature encoding or size".into());
+        }
+
+        let bytes = serde_jcs::to_vec(&Proof {
+            version: 1,
+            publisher,
+            signature,
+        })
+        .map_err(|e| e.to_string())?;
+        if bytes.len() > 64 << 10 {
+            return Err("oversized publisher proof".into());
+        }
+        Some(bytes)
+    } else {
+        None
+    };
+    let destination = File::create_new(output).map_err(fail)?;
+    let result = (|| {
+        let mut zip = ZipWriter::new(destination);
+        let options = SimpleFileOptions::default().compression_method(CompressionMethod::Stored);
+        zip.start_file("nxb.json", options)
+            .map_err(|e| e.to_string())?;
+        zip.write_all(&manifest).map_err(fail)?;
+        if let Some(proof) = &proof {
+            zip.start_file("nxb.signature.json", options)
+                .map_err(|e| e.to_string())?;
+            zip.write_all(proof).map_err(fail)?;
+        }
+        for entry in &entries {
+            let path = root.join(
+                entry
+                    .path
+                    .strip_prefix("run/")
+                    .ok_or("invalid payload path")?,
+            );
+            if !fs::symlink_metadata(&path).map_err(fail)?.is_file() {
+                return Err("payload file changed type".into());
+            }
+            zip.start_file(
+                &entry.path,
+                options
+                    .large_file(true)
+                    .unix_permissions(if entry.executable { 0o755 } else { 0o644 }),
+            )
+            .map_err(|e| e.to_string())?;
+            let (bytes, digest) = copy_hash(&path, &mut zip)?;
+            if bytes != entry.bytes || digest != entry.sha256 {
+                return Err("payload changed while packaging".into());
+            }
+        }
+        zip.finish()
+            .map_err(|e| e.to_string())?
+            .sync_all()
+            .map_err(fail)
+    })();
+    if result.is_err() {
+        let _ = fs::remove_file(output);
+    }
+    result
+}
+
+fn copy_hash(path: &Path, output: &mut impl Write) -> Result<(u64, String), String> {
+    let mut input = File::open(path).map_err(|e| e.to_string())?;
+    let mut hash = Sha256::new();
+    let mut count = 0u64;
+    let mut chunk = vec![0u8; 1 << 20];
+    loop {
+        let size = input.read(&mut chunk).map_err(|e| e.to_string())?;
+        if size == 0 {
+            break;
+        }
+        output
+            .write_all(&chunk[..size])
+            .map_err(|e| e.to_string())?;
+        hash.update(&chunk[..size]);
+        count += size as u64;
+    }
+    Ok((count, hash.finalize().to_string()))
+}
+
+fn collect(root: &Path, directory: &Path, entries: &mut Vec<Entry>) -> Result<(), String> {
+    for item in fs::read_dir(directory).map_err(|e| e.to_string())? {
+        let item = item.map_err(|e| e.to_string())?;
+        let kind = item.file_type().map_err(|e| e.to_string())?;
+        let path = item.path();
+        let relative = path.strip_prefix(root).map_err(|e| e.to_string())?;
+        let name = relative
+            .to_str()
+            .ok_or("non-UTF8 payload path")?
+            .replace(std::path::MAIN_SEPARATOR, "/");
+        if name.len() >= 4092
+            || name.nfc().collect::<String>() != name
+            || name.split('/').any(|p| {
+                p.is_empty()
+                    || p == "."
+                    || p == ".."
+                    || p.len() >= 256
+                    || p.contains('\\')
+                    || p.chars().any(|c| c.is_control())
+            })
+        {
+            return Err("unsafe payload path".into());
+        }
+        let lower = name.to_lowercase();
+        let top = lower.split('/').next().unwrap_or("");
+        if matches!(
+            top,
+            "save" | "saves" | "save_device" | "prod.keys" | "title.keys"
+        ) || top.ends_with(".p12")
+            || top.ends_with(".pfx")
+            || top.ends_with(".mobileprovision")
+        {
+            return Err("saves and signing credentials cannot be exported".into());
+        }
+        if kind.is_dir() {
+            collect(root, &path, entries)?;
+        } else if kind.is_file() {
+            let (bytes, sha256) = copy_hash(&path, &mut std::io::sink())?;
+            entries.push(Entry {
+                path: format!("run/{name}"),
+                bytes,
+                sha256,
+                executable: name == "nxgame.dylib",
+            });
+        } else {
+            return Err("payload links and special files are unsupported".into());
+        }
+    }
+    Ok(())
+}
+
+fn validate_metadata(m: &Metadata) -> Result<(), String> {
+    let hex = |s: &str, length: usize, uppercase: bool| {
+        s.len() == length
+            && s.bytes().all(|b| {
+                b.is_ascii_digit()
+                    || if uppercase {
+                        (b'A'..=b'F').contains(&b)
+                    } else {
+                        (b'a'..=b'f').contains(&b)
+                    }
+            })
+    };
+    let uuid = m.generation.split('-').collect::<Vec<_>>();
+    let version = m.min_os.split('.').collect::<Vec<_>>();
+    if m.runtime_abi == 0
+        || !hex(&m.runtime_revision, 40, false)
+        || !hex(&m.title_id, 16, true)
+        || uuid.len() != 5
+        || !uuid
+            .iter()
+            .zip([8, 4, 4, 4, 12])
+            .all(|(s, n)| hex(s, n, false))
+        || m.name.is_empty()
+        || m.name.len() > 4096
+        || m.name.contains('\0')
+        || !(1..=3).contains(&version.len())
+        || !version.iter().all(|s| {
+            !s.is_empty()
+                && s.bytes().all(|b| b.is_ascii_digit())
+                && s.parse::<u16>().is_ok_and(|n| n < 1000)
+        })
+    {
+        return Err("invalid NXB metadata".into());
+    }
+    Ok(())
+}
