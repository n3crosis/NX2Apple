diff --git a/crates/nxb-build/src/standalone/prepare.rs b/crates/nxb-build/src/standalone/prepare.rs
new file mode 100644
index 0000000..3d9062b
--- /dev/null
+++ b/crates/nxb-build/src/standalone/prepare.rs
@@ -0,0 +1,216 @@
+//! The module and manifest stages without a CLI, subprocesses or game data copies.
+use super::{analysis, auto_shaders, extract, link};
+use std::path::Path;
+
+// iOS uses the same extracted model and analysis as the existing Mac pipeline.
+fn prepare_game(
+    game: extract::Extracted,
+    output: &Path,
+    minimum_version: u32,
+    report: &dyn Fn(&str) -> bool,
+) -> Result<(), String> {
+    stage(report, "analyze")?;
+    let analyzed = analysis::analyze(&game)?;
+    let manifest = analyzed.manifest(&game);
+    // Release the original modules before allocating the linked image.
+    let npdm = game.npdm;
+    drop(game.modules);
+    stage(report, "link")?;
+    let dylib = link::dylib_for(&analyzed.modules, 2, minimum_version)?;
+    std::fs::create_dir(output).map_err(|e| e.to_string())?;
+    let result = (|| {
+        link::module_files(output, &analyzed.modules, |_, _| {})?;
+        std::fs::write(output.join("main.npdm"), npdm).map_err(|e| e.to_string())?;
+        std::fs::write(output.join("game.json"), manifest).map_err(|e| e.to_string())?;
+        std::fs::write(output.join("nxgame.dylib"), dylib).map_err(|e| e.to_string())
+    })();
+    if result.is_err() {
+        let _ = std::fs::remove_dir_all(output);
+    }
+    result
+}
+
+/// Prepare an unsigned payload from executable inputs and a resource-only tree.
+/// `resources` contains `romfs/`, optional `aoc/`, `control.nacp` and `icon.jpg`.
+/// Resources are copied as files. Shader readers use file ranges where supported,
+/// but individual decoded archives and compiled shaders may still use memory.
+/// The output must not exist. This does not package, sign or launch the payload.
+#[cfg(test)]
+pub(super) fn prepare_payload(
+    input: extract::Extracted,
+    resources: &Path,
+    output: &Path,
+    minimum_version: u32,
+) -> Result<(), String> {
+    prepare_payload_with_progress(input, resources, output, minimum_version, &|_| true)
+}
+
+fn prepare_payload_with_progress(
+    input: extract::Extracted,
+    resources: &Path,
+    output: &Path,
+    minimum_version: u32,
+    report: &dyn Fn(&str) -> bool,
+) -> Result<(), String> {
+    stage(report, "shaders")?;
+    let (files, directories) = resource_files(resources)?;
+    let shaders = auto_shaders::discover_paths(&input.modules, &files, true)?;
+    prepare_game(input, output, minimum_version, report)?;
+    stage(report, "resources")?;
+    let result = (|| {
+        for directory in directories {
+            std::fs::create_dir_all(output.join(directory)).map_err(|e| e.to_string())?;
+        }
+        for (name, source) in files {
+            let mut source = std::fs::File::open(source).map_err(|e| e.to_string())?;
+            let mut destination =
+                std::fs::File::create_new(output.join(name)).map_err(|e| e.to_string())?;
+            std::io::copy(&mut source, &mut destination).map_err(|e| e.to_string())?;
+        }
+        for (name, bytes) in shaders {
+            let path = output.join(name);
+            if let Some(parent) = path.parent() {
+                std::fs::create_dir_all(parent).map_err(|e| e.to_string())?;
+            }
+            let mut file = std::fs::File::create_new(path).map_err(|e| e.to_string())?;
+            std::io::Write::write_all(&mut file, &bytes).map_err(|e| e.to_string())?;
+        }
+        Ok(())
+    })();
+    if result.is_err() {
+        let _ = std::fs::remove_dir_all(output);
+    }
+    result
+}
+
+type ResourceFiles = (Vec<(String, std::path::PathBuf)>, Vec<String>);
+fn resource_files(root: &Path) -> Result<ResourceFiles, String> {
+    let mut files = Vec::new();
+    let mut directories = Vec::new();
+    let mut pending = vec![std::path::PathBuf::new()];
+    while let Some(relative) = pending.pop() {
+        for entry in std::fs::read_dir(root.join(&relative)).map_err(|e| e.to_string())? {
+            let entry = entry.map_err(|e| e.to_string())?;
+            let name = entry
+                .file_name()
+                .into_string()
+                .map_err(|_| "Resource filename is not UTF-8")?;
+            if name.contains('\\') {
+                return Err("Resource filenames must not contain backslashes".into());
+            }
+            if relative.as_os_str().is_empty()
+                && !matches!(name.as_str(), "romfs" | "aoc" | "control.nacp" | "icon.jpg")
+            {
+                return Err(format!("Unexpected resource entry: {name}"));
+            }
+            let path = relative.join(name);
+            let name = path
+                .to_str()
+                .ok_or("Resource path is not UTF-8")?
+                .replace('\\', "/");
+            let kind = entry.file_type().map_err(|e| e.to_string())?;
+            if kind.is_dir() {
+                directories.push(name);
+                pending.push(path);
+            } else if kind.is_file() {
+                files.push((name, entry.path()));
+            } else {
+                return Err("Resource tree must contain only regular files and directories".into());
+            }
+        }
+    }
+    files.sort_by(|a, b| a.0.cmp(&b.0));
+    directories.sort();
+    Ok((files, directories))
+}
+
+fn stage(report: &dyn Fn(&str) -> bool, name: &str) -> Result<(), String> {
+    if report(name) {
+        Ok(())
+    } else {
+        Err("Game preparation cancelled".into())
+    }
+}
+
+static BUILD: std::sync::Mutex<()> = std::sync::Mutex::new(());
+
+/// Runtime compatibility and package identity supplied by the calling shell.
+pub struct BuildMetadata {
+    /// The ABI implemented by the actual consumer runtime.
+    pub runtime_abi: u32,
+    /// The exact runtime source revision.
+    pub runtime_revision: String,
+    /// A unique lowercase UUID for the package.
+    pub generation: String,
+    /// Minimum iOS version as major.minor.patch, with trailing parts optional.
+    pub min_os: String,
+}
+
+/// Build an unsigned schema-2 NXB directly from packages or a NUP, in process.
+/// Game title and display name come from the input. The caller must provide real
+/// runtime compatibility metadata. Successful export is not proof it will launch.
+pub fn prepare_nxb(
+    args: &crate::Args,
+    output: &Path,
+    metadata: BuildMetadata,
+) -> Result<(), String> {
+    prepare_nxb_with_progress(args, output, metadata, &|_| true)
+}
+
+/// Reports actual stage transitions synchronously. Messages contain no input data.
+/// Return false to cancel before the reported stage begins.
+pub fn prepare_nxb_with_progress(
+    args: &crate::Args,
+    output: &Path,
+    metadata: BuildMetadata,
+    report: &dyn Fn(&str) -> bool,
+) -> Result<(), String> {
+    let _guard = BUILD
+        .try_lock()
+        .map_err(|_| "A package is already being prepared")?;
+    let mut version = [0_u32; 3];
+    let parts = metadata.min_os.split('.').collect::<Vec<_>>();
+    if parts.is_empty() || parts.len() > 3 {
+        return Err("Invalid minimum iOS version".into());
+    }
+    for (index, part) in parts.iter().enumerate() {
+        version[index] = part.parse().map_err(|_| "Invalid minimum iOS version")?;
+    }
+    if version[0] == 0 || version[0] > 65535 || version[1] > 255 || version[2] > 255 {
+        return Err("Invalid minimum iOS version".into());
+    }
+    let minimum_version = (version[0] << 16) | (version[1] << 8) | version[2];
+    let progress =
+        crate::events::Progress::new(crate::events::Mode::Off, Box::new(std::io::sink()));
+    stage(report, "extract")?;
+    // The caller's durable job contains snapshots and the completed archive.
+    // Only native scratch is disposable, and cleanup stays under BUILD's lock.
+    let mut args = args.clone();
+    if let Some(work) = &args.work_dir {
+        let scratch = work.join("native-scratch");
+        if scratch.exists() {
+            std::fs::remove_dir_all(&scratch).map_err(|e| e.to_string())?;
+        }
+        std::fs::create_dir_all(&scratch).map_err(|e| e.to_string())?;
+        args.work_dir = Some(scratch);
+    }
+    let disk = extract::extract_disk(&args, &progress)?;
+    let identity = crate::package::Metadata {
+        runtime_abi: metadata.runtime_abi,
+        runtime_revision: metadata.runtime_revision,
+        generation: metadata.generation,
+        min_os: metadata.min_os,
+        title_id: format!("{:016X}", disk.game.title_id),
+        name: disk.game.name.clone(),
+    };
+    let payload = disk._scratch.path().join("payload");
+    prepare_payload_with_progress(
+        disk.game,
+        &disk.resources,
+        &payload,
+        minimum_version,
+        report,
+    )?;
+    stage(report, "archive")?;
+    crate::package::write(&payload, output, &identity)
+}
