+#[test]
+fn shared_package_reader_accepts_code_only_ncz() {
+    let dir = tmp("code-only-ncz");
+    let (nca, plain) = program(APP, APP, false);
+    let mut ncz = nca[..0x4000].to_vec();
+    ncz.extend_from_slice(b"NCZSECTN");
+    ncz.extend_from_slice(&(plain.len() as u64).to_le_bytes());
+    let mut body = Vec::new();
+    for (start, bytes, fs) in plain {
+        ncz.extend_from_slice(&start.to_le_bytes());
+        ncz.extend_from_slice(&(bytes.len() as u64).to_le_bytes());
+        ncz.extend_from_slice(&3u64.to_le_bytes());
+        ncz.extend_from_slice(&0u64.to_le_bytes());
+        ncz.extend_from_slice(&CTR_KEY);
+        ncz.extend(fs[0x140..0x148].iter().rev());
+        ncz.extend_from_slice(&[0; 8]);
+        body.extend(bytes);
+    }
+    // A zstd frame with one raw final block. No external compressor is needed.
+    ncz.extend_from_slice(&[0x28, 0xb5, 0x2f, 0xfd, 0x00, 0x58]);
+    ncz.extend_from_slice(&(((body.len() as u32) << 3) | 1).to_le_bytes()[..3]);
+    ncz.extend(body);
+    let bytes = package(
+        0x81,
+        APP,
+        VERSION,
+        &[PROGRAM],
+        vec![(format!("{}.ncz", hex(&PROGRAM)), ncz)],
+    );
+    let req = request(&dir, &bytes);
+    prepare_base(&req.out_base);
+    extract_code_only_update(&req, VERSION).unwrap();
+    assert_eq!(
+        std::fs::read(req.out_base.join("ExeFS/main")).unwrap(),
+        b"NSO0new code"
+    );
+    cleanup(&dir);
+}
diff --git a/crates/nxb-extract/tests/common/nup.rs b/crates/nxb-extract/tests/common/nup.rs
new file mode 100644
index 0000000..3d86d41
--- /dev/null
+++ b/crates/nxb-extract/tests/common/nup.rs
@@ -0,0 +1,200 @@
+//! Synthetic NUP containers shared by extraction tests. No game data or keys.
+#![allow(
+    dead_code,
+    unreachable_pub,
+    clippy::unwrap_used,
+    clippy::expect_used,
+    clippy::panic
+)]
+
+/// One tree node: a folder with children or a file with content (stored raw, or as a zstd frame when `z`).
+pub enum Node {
+    Dir(&'static str, Vec<Node>),
+    File(&'static str, Vec<u8>, bool),
+}
+
+pub struct Pkg {
+    pub title: u64,
+    pub kind: u8,
+    pub version: u32,
+    pub flags: u8,
+    pub exefs: Option<Vec<Node>>,
+    pub romfs: Option<Vec<Node>>,
+    pub meta: Vec<(u16, Vec<u8>)>,
+}
+
+/// A zstd frame of one raw block (what a packer writes for incompressible data).
+fn zstd_raw(data: &[u8]) -> Vec<u8> {
+    let mut f = vec![0x28, 0xb5, 0x2f, 0xfd, 0xe0];
+    f.extend_from_slice(&(data.len() as u64).to_le_bytes());
+    let h = ((data.len() as u32) << 3) | 1;
+    f.extend_from_slice(&h.to_le_bytes()[..3]);
+    f.extend_from_slice(data);
+    f
+}
+
+#[derive(Default)]
+struct Builder {
+    dirs: Vec<(Vec<u8>, Vec<u32>)>,
+    files: Vec<(Vec<u8>, Vec<u8>, bool)>,
+}
+
+impl Builder {
+    /// Adds a folder and returns its index, children are slot values (folders: index, files: dirs + index, fixed later).
+    fn add(&mut self, name: &str, kids: &[Node]) -> u32 {
+        let me = self.dirs.len() as u32;
+        self.dirs.push((name.as_bytes().to_vec(), Vec::new()));
+        let mut slots = Vec::new();
+        for k in kids {
+            match k {
+                Node::Dir(n, c) => slots.push(self.add(n, c)),
+                Node::File(n, d, z) => {
+                    self.files.push((n.as_bytes().to_vec(), d.clone(), *z));
+                    slots.push(0x8000_0000 | (self.files.len() - 1) as u32);
+                }
+            }
+        }
+        self.dirs[me as usize].1 = slots;
+        me
+    }
+}
+
+pub fn build(pkgs: &[Pkg], corrupt_toc: bool) -> Vec<u8> {
+    let mut b = Builder::default();
+    let mut recs = Vec::new();
+    for p in pkgs {
+        let ex = p.exefs.as_ref().map(|k| b.add("exefs", k));
+        let ro = p.romfs.as_ref().map(|k| b.add("romfs", k));
+        let root = b.add("root", &[]);
+        let mut slots = Vec::new();
+        slots.extend(ex);
+        slots.extend(ro);
+        b.dirs[root as usize].1 = slots;
+        recs.push((root, ex.unwrap_or(u32::MAX), ro.unwrap_or(u32::MAX)));
+    }
+    let nd = b.dirs.len() as u32;
+    let mut pool = Vec::new();
+    let mut name = |n: &[u8]| {
+        let o = pool.len() as u32;
+        pool.extend_from_slice(n);
+        (o, n.len() as u32)
+    };
+    let names_d: Vec<(u32, u32)> = b.dirs.iter().map(|d| name(&d.0)).collect();
+    let names_f: Vec<(u32, u32)> = b.files.iter().map(|f| name(&f.0)).collect();
+    let mut slots = Vec::new();
+    let mut firsts = Vec::new();
+    for d in &b.dirs {
+        firsts.push((slots.len() as u32, d.1.len() as u32));
+        for &s in &d.1 {
+            slots.push(if s & 0x8000_0000 != 0 {
+                nd + (s & 0x7fff_ffff)
+            } else {
+                s
+            });
+        }
+    }
+    let toc_len_fixed =
+        0x30 + pkgs.len() * 0x40 + b.dirs.len() * 0x18 + b.files.len() * 0x50 + slots.len() * 4;
+    let pool_off = toc_len_fixed;
+    let toc_size = pool_off + pool.len();
+    let blob = (0x80 + toc_size).div_ceil(16) * 16;
+    // data region: files, then meta blocks
+    let mut data = Vec::new();
+    let mut extents = Vec::new();
+    for (_, d, z) in &b.files {
+        if d.is_empty() {
+            extents.push((0u64, 0u64, false));
+            continue;
+        }
+        while !(blob + data.len()).is_multiple_of(16) {
+            data.push(0);
+        }
+        let stored = if *z { zstd_raw(d) } else { d.clone() };
+        extents.push(((blob + data.len()) as u64, stored.len() as u64, *z));
+        data.extend_from_slice(&stored);
+    }
+    let mut metas = Vec::new();
+    for p in pkgs {
+        let mut m = Vec::new();
+        for (t, v) in &p.meta {
+            m.extend_from_slice(&t.to_le_bytes());
+            m.extend_from_slice(&0u16.to_le_bytes());
+            m.extend_from_slice(&(v.len() as u32).to_le_bytes());
+            m.extend_from_slice(v);
+        }
+        metas.push(if m.is_empty() {
+            (0u64, 0u32)
+        } else {
+            ((blob + data.len()) as u64, m.len() as u32)
+        });
+        data.extend_from_slice(&m);
+    }
+    let mut toc = Vec::new();
+    toc.extend_from_slice(b"TOC\x01");
+    toc.extend_from_slice(&(pkgs.len() as u32).to_le_bytes());
+    for v in [
+        b.dirs.len() as u64,
+        b.files.len() as u64,
+        pool_off as u64,
+        pool.len() as u64,
+        0,
+    ] {
+        toc.extend_from_slice(&v.to_le_bytes());
+    }
+    for (i, p) in pkgs.iter().enumerate() {
+        let (root, ex, ro) = recs[i];
+        toc.extend_from_slice(&p.title.to_le_bytes());
+        for v in [root, ex, ro, p.version] {
+            toc.extend_from_slice(&v.to_le_bytes());
+        }
+        toc.extend_from_slice(&[p.kind, p.flags, 0, 0, 0, 0, 0, 0]);
+        toc.extend_from_slice(&metas[i].0.to_le_bytes());
+        toc.extend_from_slice(&metas[i].1.to_le_bytes());
+        toc.extend_from_slice(&[0u8; 20]);
+    }
+    for (i, _) in b.dirs.iter().enumerate() {
+        let (o, n) = names_d[i];
+        for v in [o, n, firsts[i].0, firsts[i].1] {
+            toc.extend_from_slice(&v.to_le_bytes());
+        }
+        toc.extend_from_slice(&0u64.to_le_bytes());
+    }
+    for (i, (_, d, _)) in b.files.iter().enumerate() {
+        let (o, n) = names_f[i];
+        toc.extend_from_slice(&o.to_le_bytes());
+        toc.extend_from_slice(&n.to_le_bytes());
+        let (off, stored, z) = extents[i];
+        for v in [d.len() as u64, off, stored] {
+            toc.extend_from_slice(&v.to_le_bytes());
+        }
+        toc.extend_from_slice(&nxb_model::sha256(d).0);
+        toc.extend_from_slice(&[u8::from(z), 0, 0, 0]);
+        toc.extend_from_slice(&[0u8; 12]);
+    }
+    for s in &slots {
+        toc.extend_from_slice(&s.to_le_bytes());
+    }
+    toc.extend_from_slice(&pool);
+    assert_eq!(toc.len(), toc_size);
+    let mut sha = nxb_model::sha256(&toc).0;
+    if corrupt_toc {
+        sha[0] ^= 1;
+    }
+    let total = blob + data.len();
+    let mut out = Vec::new();
+    out.extend_from_slice(b"NUP\x01");
+    out.extend_from_slice(&0x80u16.to_le_bytes());
+    out.extend_from_slice(&0u16.to_le_bytes());
+    out.extend_from_slice(&0x80u64.to_le_bytes());
+    out.extend_from_slice(&(toc_size as u64).to_le_bytes());
+    out.extend_from_slice(&sha);
+    out.extend_from_slice(&(blob as u64).to_le_bytes());
+    out.extend_from_slice(&(total as u64).to_le_bytes());
+    out.extend_from_slice(&(pkgs.len() as u32).to_le_bytes());
+    out.extend_from_slice(&0u32.to_le_bytes());
+    out.extend_from_slice(&[0u8; 48]);
+    out.extend_from_slice(&toc);
+    out.resize(blob, 0);
+    out.extend_from_slice(&data);
+    out
+}
diff --git a/crates/nxb-extract/tests/common/sparse.rs b/crates/nxb-extract/tests/common/sparse.rs
new file mode 100644
index 0000000..6dd8136
--- /dev/null
+++ b/crates/nxb-extract/tests/common/sparse.rs
@@ -0,0 +1,212 @@
+//! Shared authored sparse NCA and BKTR update fixture. No game data or real keys.
+#![allow(
+    dead_code,
+    unreachable_pub,
+    clippy::unwrap_used,
+    clippy::expect_used,
+    clippy::panic
+)]
+
+use super::common::*;
+use nxb_extract::aes::Aes128;
+
+pub const APP: u64 = 0x0100_0000_0000_2000;
+const NODE: usize = 0x4000;
+
+fn rom() -> Vec<(&'static str, Vec<u8>)> {
+    vec![
+        ("a.bin", vec![0x11; 0x8000]),
+        ("b.bin", (0..0x10000u32).map(|i| (i * 7) as u8).collect()),
+        ("c.bin", vec![0x33; 0x8000]),
+    ]
+}
+
+fn exefs(tag: u8) -> Section {
+    pfs0_section(&[
+        ("main".to_string(), vec![tag; 0x500]),
+        ("main.npdm".into(), npdm(APP)),
+    ])
+}
+
+/// A bucket tree of one entry set: the offset node, then the entry node.
+fn bucket_tree(entry_size: usize, entries: &[Vec<u8>], end: u64) -> Vec<u8> {
+    let mut t = vec![0u8; 2 * NODE];
+    t[4..8].copy_from_slice(&1u32.to_le_bytes());
+    t[8..16].copy_from_slice(&end.to_le_bytes());
+    t[NODE + 4..NODE + 8].copy_from_slice(&(entries.len() as u32).to_le_bytes());
+    for (i, e) in entries.iter().enumerate() {
+        assert_eq!(e.len(), entry_size);
+        t[NODE + 16 + i * entry_size..NODE + 16 + (i + 1) * entry_size].copy_from_slice(e);
+    }
+    t
+}
+
+fn indirect(virt: u64, phys: u64, source: u32) -> Vec<u8> {
+    let mut e = virt.to_le_bytes().to_vec();
+    e.extend_from_slice(&phys.to_le_bytes());
+    e.extend_from_slice(&source.to_le_bytes());
+    e
+}
+
+/// The counter's upper half as the NCA code derives it from the FS header's bytes at 0x140.
+fn upper_of(fs: &[u8]) -> [u8; 8] {
+    let mut u: [u8; 8] = fs[0x140..0x148].try_into().unwrap();
+    u.reverse();
+    u
+}
+
+pub struct Fixture {
+    pub base: Vec<u8>,
+    pub update: Vec<u8>,
+    pub image: Vec<(String, Vec<u8>)>,
+}
+
+/// A base NSP whose RomFS section lacks `[hole.0, hole.1)`, and an update NSP that supplies that range.
+pub fn fixture() -> Fixture {
+    let hole = (0x10000u64, 0x18000u64);
+    let data = romfs_section(&rom());
+    let full = data.bytes.clone();
+    let virt = full.len() as u64;
+    assert!(virt > hole.1 && virt.is_multiple_of(NODE as u64));
+    let ex = exefs(3);
+    let sec0_len = ex.bytes.len() as u64;
+    let start = 0x4000 + sec0_len;
+
+    // the base: data ranges, then the table
+    let kept = hole.0 + (virt - hole.1);
+    let table = bucket_tree(
+        0x14,
+        &[
+            indirect(0, 0, 0),
+            indirect(hole.0, 0, 1),
+            indirect(hole.1, hole.0, 0),
+        ],
+        virt,
+    );
+    let phys_off = start + virt;
+    let mut fs = data.fs.clone();
+    fs[0x148..0x150].copy_from_slice(&kept.to_le_bytes());
+    fs[0x150..0x158].copy_from_slice(&(table.len() as u64).to_le_bytes());
+    fs[0x158..0x15C].copy_from_slice(b"BKTR");
+    fs[0x15C..0x160].copy_from_slice(&1u32.to_le_bytes());
+    fs[0x160..0x164].copy_from_slice(&3u32.to_le_bytes());
+    fs[0x168..0x170].copy_from_slice(&phys_off.to_le_bytes());
+    fs[0x170..0x172].copy_from_slice(&1u16.to_le_bytes());
+    let sparse_fs = fs.clone();
+    let (mut prog, _) = nca(
+        0,
+        APP,
+        vec![
+            (0, ex),
+            (
+                1,
+                Section {
+                    bytes: data.bytes,
+                    fs,
+                },
+            ),
+        ],
+    );
+    let (s, e) = (start as usize, (start + virt) as usize);
+    let ct = prog[s..e].to_vec();
+    prog[s..e].fill(0);
+    let mut phys = ct[..hole.0 as usize].to_vec();
+    phys.extend_from_slice(&ct[hole.1 as usize..]);
+    assert_eq!(phys.len() as u64, kept);
+    let mut meta = table;
+    let v = (u64::from_be_bytes(upper_of(&sparse_fs)) & !0xffff_ffff) | (1 << 16);
+    Aes128::new(&CTR_KEY).ctr(v.to_be_bytes(), phys_off + kept, &mut meta);
+    phys.extend_from_slice(&meta);
+    assert_eq!(prog.len() as u64, phys_off);
+    prog.extend_from_slice(&phys);
+    let base = pkg(&prog, 0x80, APP, 0);
+
+    // the update: the hole's data, the indirect table and the counter table
+    let patch_data = full[hole.0 as usize..hole.1 as usize].to_vec();
+    let d = patch_data.len() as u64;
+    let ind = bucket_tree(
+        0x14,
+        &[
+            indirect(0, 0, 0),
+            indirect(hole.0, 0, 1),
+            indirect(hole.1, hole.1, 0),
+        ],
+        virt,
+    );
+    let mut ctr_entry = 0u64.to_le_bytes().to_vec();
+    ctr_entry.extend_from_slice(&[0, 0, 0, 0]);
+    ctr_entry.extend_from_slice(&5u32.to_le_bytes());
+    let ctr = bucket_tree(0x10, &[ctr_entry], d);
+    let pfs = fs_patch(&sparse_fs, d, ind.len() as u64, ctr.len() as u64);
+    let mut bytes = patch_data;
+    bytes.extend_from_slice(&ind);
+    bytes.extend_from_slice(&ctr);
+    let len = bytes.len();
+    let (mut up, _) = nca(
+        0,
+        APP,
+        vec![
+            (0, exefs(4)),
+            (
+                1,
+                Section {
+                    bytes: vec![0; len],
+                    fs: pfs,
+                },
+            ),
+        ],
+    );
+    let upd_start = 0x4000 + exefs(4).bytes.len();
+    let upd_end = upd_start + len;
+    let plain = upper_of(&sparse_fs);
+    let mut gen5 = plain;
+    gen5[4..8].copy_from_slice(&5u32.to_be_bytes());
+    let aes = Aes128::new(&CTR_KEY);
+    aes.ctr(gen5, upd_start as u64, &mut bytes[..d as usize]);
+    aes.ctr(plain, upd_start as u64 + d, &mut bytes[d as usize..]);
+    up[upd_start..upd_end].copy_from_slice(&bytes);
+    let update = pkg(&up, 0x81, APP | 0x800, 1 << 16);
+
+    let image = {
+        let mut v: Vec<_> = rom()
+            .into_iter()
+            .map(|(n, b)| (format!("/{n}"), b))
+            .collect();
+        v.sort();
+        v
+    };
+    Fixture {
+        base,
+        update,
+        image,
+    }
+}
+
+/// The update's FS header: the data section's IVFC part with a BKTR patch part.
+fn fs_patch(base_fs: &[u8], d: u64, ind_size: u64, ctr_size: u64) -> Vec<u8> {
+    let mut fs = base_fs.to_vec();
+    fs[0x148..0x172].fill(0);
+    fs[4] = 4;
+    fs[0x100..0x108].copy_from_slice(&d.to_le_bytes());
+    fs[0x108..0x110].copy_from_slice(&ind_size.to_le_bytes());
+    fs[0x110..0x114].copy_from_slice(b"BKTR");
+    fs[0x114..0x118].copy_from_slice(&1u32.to_le_bytes());
+    fs[0x118..0x11C].copy_from_slice(&3u32.to_le_bytes());
+    fs[0x120..0x128].copy_from_slice(&(d + ind_size).to_le_bytes());
+    fs[0x128..0x130].copy_from_slice(&ctr_size.to_le_bytes());
+    fs[0x130..0x134].copy_from_slice(b"BKTR");
+    fs[0x134..0x138].copy_from_slice(&1u32.to_le_bytes());
+    fs[0x138..0x13C].copy_from_slice(&1u32.to_le_bytes());
+    fs
+}
+
+/// An NSP of a program NCA and the meta NCA that lists it.
+fn pkg(program: &[u8], kind: u8, title: u64, version: u32) -> Vec<u8> {
+    let pid = [if kind == 0x80 { 7u8 } else { 8 }; 16];
+    let meta = pfs0_section(&[("m.cnmt".into(), cnmt(kind, title, version, &[pid]))]);
+    let (m, _) = nca(1, APP, vec![(0, meta)]);
+    pfs0(&[
+        (format!("{}.nca", hex(&pid)), program.to_vec()),
+        (format!("{}.cnmt.nca", hex(&[9u8; 16])), m),
+    ])
+}
